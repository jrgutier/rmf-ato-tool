{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:conformance-nist-tasks",
  "title": "SP 800-37r2 Chapter 3 task pin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ref",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ref": {
      "const": "SP800-37R2"
    },
    "tasks": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "inputs",
          "outputs",
          "primary",
          "supporting"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[PCSIARM]-\\d{1,2}$"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "primary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supporting": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sdlc": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "new",
              "existing"
            ],
            "properties": {
              "new": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "existing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
