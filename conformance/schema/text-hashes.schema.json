{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:conformance-text-hashes",
  "title": "Reviewed text hashes",
  "description": "SHA-256 of each reference text the register was reviewed against. Written by rmf conformance accept-text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hashes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "hashes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9.-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
