{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:conformance-triage",
  "title": "Triage patterns",
  "description": "Reviewed patterns that mark candidates of one document not-applicable in bulk. A pattern names its document, a statement or context regex, a reason, and the entries the reviewer read before writing it. FW-REQ-004 bounds its reach and refuses it on tier 1 documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ref",
          "reason",
          "sample"
        ],
        "anyOf": [
          {
            "required": [
              "statement"
            ]
          },
          {
            "required": [
              "context"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TP-\\d{2,}$"
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.-]+$"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "statement": {
            "type": "string",
            "minLength": 8,
            "description": "Regex searched in the statement."
          },
          "context": {
            "type": "string",
            "minLength": 8,
            "description": "Regex searched in the context."
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "sample": {
            "description": "Entries the reviewer read before writing the pattern; each must match it.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[A-Z][A-Z0-9.-]+-\\d{4}$"
            }
          }
        }
      }
    }
  }
}
