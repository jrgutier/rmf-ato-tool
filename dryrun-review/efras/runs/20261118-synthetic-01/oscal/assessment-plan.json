    "terms-and-conditions": {
      "parts": [
        {
          "name": "rules-of-engagement",
          "title": "Rules of engagement",
          "prose": "All testing in the pre-production account with synthetic data, built from the production templates; nothing against production, live data or networks beyond the access point path. Scans are authenticated with accounts the PM issues for the window. The ISSO and the CSSP are told source addresses and times before every scan and test; the ISSM can stop any test; a critical finding goes to the ISSM and the AODR within one working day. No denial of service, no social engineering, no data leaves the account."
        },
        {
          "name": "assessment-team",
          "title": "Assessment team",
          "prose": "PER-SCA (Lead assessor of the business systems SCA team (Component independent assessment activity), with a cloud and container assessor and a privacy-trained assessor, independent)"
        }
      ]
    },
