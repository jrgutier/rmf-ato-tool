{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rmf-tool.invalid/schema/references-index.schema.json",
  "title": "references/index.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "references"],
  "properties": {
    "schema_version": {"const": 1},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "publisher", "revision", "kind", "required", "acquisition", "urls",
        "landing_url", "resolved_url", "local_path", "sha256", "size_bytes", "downloaded",
        "revision_note", "status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[.-][A-Z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"enum": ["NIST", "DoD", "CNSS", "DoD CIO", "DISA"]},
        "revision": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["pdf", "oscal-catalog", "oscal-profile", "oscal-resolved-catalog",
                   "oscal-schema", "oscal-example", "web"]
        },
        "required": {"type": "boolean"},
        "acquisition": {"enum": ["auto", "browser-assisted", "none"]},
        "urls": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}},
        "landing_url": {"type": ["string", "null"], "pattern": "^https?://"},
        "resolved_url": {"type": ["string", "null"], "pattern": "^https?://[^?#]*$"},
        "local_path": {"type": ["string", "null"], "pattern": "^references/[^\\s]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 1},
        "downloaded": {"$ref": "#/$defs/date"},
        "revision_note": {"$ref": "#/$defs/nullableString"},
        "status": {
          "enum": ["ok", "pending-acquisition", "manual-required", "missing", "changed",
                   "degraded"]
        },
        "degraded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved_by", "date", "reason", "fallback_refs"],
          "properties": {
            "approved_by": {"const": "user"},
            "date": {"type": "string", "format": "date"},
            "reason": {"type": "string", "minLength": 1},
            "fallback_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "source_sha256", "extractor", "extractor_version",
                       "rmf_extract_version", "pages", "sha256", "ocr", "ocr_pages"],
          "properties": {
            "path": {"type": "string", "pattern": "^references/text/[^\\s]+\\.md$"},
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "extractor": {"enum": ["pymupdf", "pdfplumber"]},
            "extractor_version": {"type": "string", "minLength": 1},
            "rmf_extract_version": {"type": "string", "minLength": 1},
            "pages": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "ocr": {"type": "boolean"},
            "ocr_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"acquisition": {"const": "auto"}}},
          "then": {"properties": {"urls": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"acquisition": {"const": "browser-assisted"}}},
          "then": {"required": ["landing_url"], "properties": {"landing_url": {"type": "string"}}}
        },
        {
          "if": {"properties": {"status": {"const": "ok"}, "kind": {"not": {"const": "web"}}}},
          "then": {
            "properties": {
              "local_path": {"type": "string"},
              "sha256": {"type": "string"},
              "size_bytes": {"type": "integer"},
              "downloaded": {"type": "string"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "degraded"}}},
          "then": {"required": ["degraded"]}
        },
        {
          "if": {"properties": {"kind": {"not": {"const": "pdf"}}}},
          "then": {"not": {"required": ["text"]}}
        }
      ]
    }
  }
}
