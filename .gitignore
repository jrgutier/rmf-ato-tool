# Python / uv
.venv/
.venv-agent/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Optional tools that bootstrap installs (OSCAL_CLI=1)
.tools/

# OMC orchestration state
.omc/

# References: inbox for browser-assisted downloads, local fetch log
references/_inbox/
references/fetch-log.jsonl
# Left behind if rmf refs fetch is killed mid-download
references/pdf/fetch-*.pdf
references/**/fetch-*.part

# Run reports that `rmf check` / `rmf status` write into fixture and agent-result runs
tests/fixtures/runs/*/reports/check.json
tests/fixtures/runs/*/reports/check.md
tests/fixtures/runs/*/reports/status.md
tests/fixtures/runs/*/reports/metrics.json
tests/agent/results/*/run/reports/check.json
tests/agent/results/*/run/reports/check.md
tests/agent/results/*/run/reports/status.md
tests/agent/results/*/run/reports/metrics.json

# OS
.DS_Store
