{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:sar-report",
  "title": "runs/<run-id>/artifacts/data/sar-report.yaml",
  "description": "What the assessment report says as a whole (A-3, A-4): the methodology used, who received the report, and the CISO's judgment of the assessment. Determinations and findings live in sar/results (ART-SAR).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "methodology",
    "sources"
  ],
  "properties": {
    "methodology": {
      "title": "Security control assessment methodology",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard"
      ],
      "properties": {
        "standard": {
          "title": "Methodology and procedures used to assess controls",
          "type": "string",
          "minLength": 1
        },
        "deviation_rationale": {
          "title": "Rationale for deviation from standard assessment resources",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delivered": {
      "title": "Delivery of the assessment results",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to",
          "date"
        ],
        "properties": {
          "to": {
            "title": "Who receives the assessment results",
            "$ref": "#/$defs/persona_id"
          },
          "date": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "quality_review": {
      "title": "The CISO's assessment of quality, capacity, visibility and effectiveness",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "date",
        "quality",
        "capacity",
        "visibility",
        "effectiveness"
      ],
      "properties": {
        "by": {
          "title": "The CISO who assesses the security control assessments",
          "$ref": "#/$defs/persona_id"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "quality": {
          "$ref": "#/$defs/rating"
        },
        "capacity": {
          "$ref": "#/$defs/rating"
        },
        "visibility": {
          "$ref": "#/$defs/rating"
        },
        "effectiveness": {
          "$ref": "#/$defs/rating"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "privacy": {
      "title": "Privacy assessment report of a system processing PII: who documented the privacy control assessment results and how they reach the authorizing official (PASM-002)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessed_by",
        "date",
        "provided",
        "sources"
      ],
      "properties": {
        "assessed_by": {
          "title": "Privacy control assessors who documented the results of the privacy control assessments",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/persona_id"
          }
        },
        "date": {
          "title": "When the privacy control assessment was completed",
          "$ref": "#/$defs/date"
        },
        "provided": {
          "title": "The senior agency official for privacy provides the privacy information to the authorizing official",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "to",
            "date"
          ],
          "properties": {
            "by": {
              "$ref": "#/$defs/persona_id"
            },
            "to": {
              "$ref": "#/$defs/persona_id"
            },
            "date": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "rating": {
      "title": "A rating of the security control assessment",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "basis"
      ],
      "properties": {
        "rating": {
          "enum": [
            "adequate",
            "inadequate"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
