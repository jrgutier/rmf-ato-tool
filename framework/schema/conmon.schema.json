{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:conmon",
  "title": "runs/<run-id>/artifacts/data/conmon.yaml",
  "description": "System continuous monitoring strategy (S-5; updated by M-2). Every baseline family needs a frequency (CONMON-001).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frequencies",
    "ongoing_authorization",
    "reporting",
    "sources"
  ],
  "properties": {
    "frequencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "frequency",
          "method",
          "responsible"
        ],
        "properties": {
          "family": {
            "$ref": "#/$defs/family"
          },
          "frequency": {
            "enum": [
              "continuous",
              "daily",
              "weekly",
              "monthly",
              "quarterly",
              "semi-annually",
              "annually",
              "event-driven"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "responsible": {
            "$ref": "#/$defs/persona_id"
          }
        }
      },
      "minItems": 1
    },
    "ongoing_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_trigger_days",
        "event_triggers"
      ],
      "properties": {
        "time_trigger_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "event_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipients",
        "frequency"
      ],
      "properties": {
        "recipients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persona_id"
          },
          "minItems": 1
        },
        "frequency": {
          "enum": [
            "continuous",
            "monthly",
            "quarterly",
            "annually"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "detection_coverage": {
      "title": "The asset classes continuous monitoring covers at all times to find anomalies, indicators of compromise and other potentially adverse events (SP 800-61r3 DE.CM)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_class",
          "means"
        ],
        "properties": {
          "asset_class": {
            "enum": [
              "networks",
              "physical-environment",
              "personnel-activity",
              "external-providers",
              "computing"
            ]
          },
          "means": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tuning": {
      "title": "How monitoring technologies are tuned to reduce false positives and false negatives to acceptable levels",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "family": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
