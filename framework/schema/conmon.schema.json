{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:conmon",
  "title": "runs/<run-id>/artifacts/data/conmon.yaml",
  "description": "System continuous monitoring strategy (S-5; updated by M-2). Every baseline family needs a frequency (CONMON-001). From framework_version 0.2.0 the strategy also states its frequency criteria, automated tools, data architecture, monitoring kinds, event triggers, boundary review, threat monitoring, metrics, delegations and risk assessment upkeep (ISCM-001..006); MRPT-001 reads reporting.dodin, MMEAS-001 the measurement block; the ISCM keys stay optional here so a run on an older contract still validates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frequencies",
    "ongoing_authorization",
    "reporting",
    "sources"
  ],
  "properties": {
    "frequencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "frequency",
          "method",
          "responsible"
        ],
        "properties": {
          "family": {
            "$ref": "#/$defs/family"
          },
          "frequency": {
            "title": "How often the family is monitored, at least",
            "$ref": "#/$defs/frequency",
            "x-enforces": [
              "REQ-SP800-137-0204"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "responsible": {
            "$ref": "#/$defs/persona_id"
          },
          "criteria": {
            "title": "Frequency criteria that set this frequency, or ART-ORG-CONTEXT where the organizational strategy sets it",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(FC-\\d{2}|ART-ORG-CONTEXT)$"
            },
            "x-enforces": [
              "REQ-SP800-137-0184"
            ]
          },
          "overrides": {
            "title": "Controls of the family monitored at another minimum frequency",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "control",
                "frequency",
                "reason"
              ],
              "properties": {
                "control": {
                  "$ref": "#/$defs/control"
                },
                "frequency": {
                  "$ref": "#/$defs/frequency"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "x-enforces": [
              "REQ-SP800-137-0142",
              "REQ-SP800-137-0159"
            ]
          }
        }
      }
    },
    "ongoing_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_trigger_days",
        "event_triggers"
      ],
      "properties": {
        "time_trigger_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "event_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipients",
        "frequency"
      ],
      "properties": {
        "recipients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persona_id"
          },
          "minItems": 1
        },
        "frequency": {
          "enum": [
            "continuous",
            "monthly",
            "quarterly",
            "annually"
          ]
        },
        "dodin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "designation"
          ],
          "properties": {
            "designation": {
              "title": "GENSER or SE designation of the system, which sets who receives POA&M updates, or not-connected",
              "enum": [
                "GENSER",
                "SE",
                "not-connected"
              ]
            },
            "awareness": {
              "title": "What ISCM gives awareness of for DODIN operations",
              "type": "array",
              "items": {
                "enum": [
                  "threats",
                  "traffic",
                  "fault",
                  "performance",
                  "bandwidth",
                  "route",
                  "network-management",
                  "employee-use"
                ]
              }
            },
            "required_by": {
              "title": "DoD bodies that required POA&M updates or vulnerability coordination of this system, each with who required it (the duty is owed as required)",
              "type": "object",
              "propertyNames": {
                "enum": [
                  "CDRUSSTRATCOM",
                  "DISA",
                  "DIA",
                  "JFHQ-DODIN"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "date",
        "sources"
      ],
      "properties": {
        "approved_by": {
          "title": "Official who approved the strategy and the minimum frequency of each control",
          "$ref": "#/$defs/persona_id"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "title": "Approval of the continuous monitoring strategy by the authorizing official"
    },
    "organizational_frequencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families",
        "sources"
      ],
      "properties": {
        "families": {
          "title": "Families whose frequency the organizational strategy sets",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/family"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "title": "Families the organizational continuous monitoring strategy sets the frequency of"
    },
    "frequency_criteria": {
      "title": "Criteria for determining the frequency with which controls are monitored, where the organizational strategy does not set it",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "description",
          "established_by",
          "consulted",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FC-\\d{2}$"
          },
          "criterion": {
            "title": "SP 800-137 consideration the criterion applies",
            "enum": [
              "volatility",
              "impact-level",
              "critical-function",
              "known-weakness",
              "threat-information",
              "vulnerability-information",
              "risk-assessment",
              "reporting-requirement",
              "risk-tolerance",
              "resources",
              "other"
            ],
            "x-enforces": [
              "REQ-SP800-137-0053",
              "REQ-SP800-137-0054",
              "REQ-SP800-137-0144",
              "REQ-SP800-137-0147",
              "REQ-SP800-137-0148",
              "REQ-SP800-137-0150",
              "REQ-SP800-137-0152",
              "REQ-SP800-137-0153",
              "REQ-SP800-137-0155",
              "REQ-SP800-137-0157",
              "REQ-SP800-137-0158",
              "REQ-SP800-137-0219",
              "REQ-SP800-137-0220",
              "REQ-SP800-39-0188"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "established_by": {
            "title": "System owner or common control provider who established the criterion",
            "$ref": "#/$defs/persona_id",
            "x-enforces": [
              "REQ-SP800-137-0104"
            ]
          },
          "consulted": {
            "title": "Organizational officials the criterion was established with",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/persona_id"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "tools": {
      "title": "Automated tools that assess controls",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "assesses",
          "method",
          "frequency",
          "analysis",
          "reporting",
          "selection",
          "upkeep",
          "responsible",
          "strategy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TOOL-\\d{2}$"
          },
          "strategy": {
            "title": "Assessment strategy the tool follows; desired-state needs the desired_state block",
            "enum": [
              "desired-state",
              "other"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "assesses": {
            "title": "Controls the automated tool assesses",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/control"
            },
            "x-enforces": [
              "REQ-SP800-137-0205"
            ]
          },
          "method": {
            "title": "Assessment method the automated tool uses",
            "enum": [
              "test",
              "examine",
              "interview"
            ]
          },
          "frequency": {
            "title": "Frequency with which the tool assesses its controls",
            "$ref": "#/$defs/frequency",
            "x-enforces": [
              "REQ-DODI5000.82-0173"
            ]
          },
          "analysis": {
            "title": "Analysis requirements for the tool's results",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-53AR5-0321"
            ]
          },
          "reporting": {
            "title": "Reporting requirements for the tool's results",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-137-0063"
            ]
          },
          "selection": {
            "title": "Criteria the tool was chosen by",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-137-0059",
              "REQ-SP800-137-0060",
              "REQ-SP800-137-0061",
              "REQ-SP800-137-0062"
            ]
          },
          "upkeep": {
            "title": "How the automation is validated and kept up",
            "type": "string",
            "minLength": 1
          },
          "responsible": {
            "$ref": "#/$defs/persona_id"
          },
          "desired_state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actual_state",
              "desired_state",
              "defects"
            ],
            "properties": {
              "actual_state": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "collection",
                  "controls",
                  "specification"
                ],
                "properties": {
                  "collection": {
                    "enum": [
                      "automated",
                      "manual"
                    ]
                  },
                  "controls": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/control"
                    }
                  },
                  "specification": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "desired_state": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "controls",
                  "data",
                  "specification"
                ],
                "properties": {
                  "controls": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/control"
                    }
                  },
                  "data": {
                    "title": "Data the desired state rests on: STIG benchmarks or product files",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^(BM-\\d{2,3}|product/\\S+)$"
                    }
                  },
                  "specification": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "defects": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "recorded_in"
                ],
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recorded_in": {
                    "enum": [
                      "poam",
                      "sar-results"
                    ]
                  }
                }
              }
            },
            "title": "Desired state specification strategy the tool follows",
            "x-enforces": [
              "REQ-SP800-53AR5-0320"
            ]
          }
        }
      },
      "x-enforces": [
        "REQ-SP800-137-0118"
      ]
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "storage",
        "analysis",
        "retrieval",
        "delivery",
        "automated",
        "manual"
      ],
      "properties": {
        "collection": {
          "title": "How monitoring data is collected",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-137-0078"
          ]
        },
        "storage": {
          "title": "Where monitoring data is stored and consolidated",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-137-0064"
          ]
        },
        "analysis": {
          "title": "How monitoring data is analyzed",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-137-0167"
          ]
        },
        "retrieval": {
          "title": "How monitoring data is retrieved and presented",
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "title": "How monitoring data is delivered within and between tiers",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-137-0170"
          ]
        },
        "automated": {
          "title": "Where monitoring is automated",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-137-0055"
          ]
        },
        "manual": {
          "title": "Where monitoring is not automated, and why",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-137-0057"
          ]
        }
      },
      "title": "How monitoring data is collected, stored, analyzed, retrieved and delivered",
      "x-enforces": [
        "REQ-SP800-137-0166"
      ]
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compliance",
        "effectiveness",
        "change"
      ],
      "properties": {
        "compliance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "responsible"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "responsible": {
              "$ref": "#/$defs/persona_id"
            }
          },
          "title": "How compliance with planned risk responses is monitored",
          "x-enforces": [
            "REQ-SP800-39-0182"
          ]
        },
        "effectiveness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "responsible"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "responsible": {
              "$ref": "#/$defs/persona_id"
            }
          },
          "title": "How the effectiveness of risk responses is monitored",
          "x-enforces": [
            "REQ-SP800-137-0027",
            "REQ-SP800-39-0183",
            "REQ-SP800-39-0292"
          ]
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "responsible"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "responsible": {
              "$ref": "#/$defs/persona_id"
            }
          },
          "title": "How changes to the system and its environment are monitored",
          "x-enforces": [
            "REQ-SP800-39-0191"
          ]
        }
      },
      "title": "Compliance, effectiveness and change monitoring",
      "x-enforces": [
        "REQ-SP800-39-0030",
        "REQ-SP800-39-0179",
        "REQ-SP800-39-0181",
        "REQ-SP800-39-0303"
      ]
    },
    "events": {
      "title": "Event-driven assessment and authorization criteria",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event",
          "description",
          "threshold",
          "triggers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EV-\\d{2}$"
          },
          "event": {
            "title": "Kind of event the criterion covers",
            "enum": [
              "incident",
              "threat-information",
              "significant-change",
              "mission-change",
              "impact-analysis",
              "risk-assessment",
              "other"
            ],
            "x-enforces": [
              "REQ-SP800-137-0165"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "title": "Threshold at which the event triggers",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-137-0225"
            ]
          },
          "triggers": {
            "title": "Whether the event triggers an assessment, a reauthorization or both",
            "enum": [
              "assessment",
              "reauthorization",
              "assessment-and-reauthorization"
            ],
            "x-enforces": [
              "REQ-SP800-137-0223"
            ]
          }
        }
      }
    },
    "boundary_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency",
        "responsible"
      ],
      "properties": {
        "frequency": {
          "$ref": "#/$defs/frequency"
        },
        "responsible": {
          "$ref": "#/$defs/persona_id"
        }
      },
      "title": "Periodic review of the authorization boundary scope"
    },
    "threat_monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsible",
        "frequency",
        "feeds",
        "watches"
      ],
      "properties": {
        "responsible": {
          "$ref": "#/$defs/persona_id"
        },
        "frequency": {
          "$ref": "#/$defs/frequency"
        },
        "feeds": {
          "title": "Threat information sources watched",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "x-enforces": [
            "REQ-DODI5000.90-0092"
          ]
        },
        "watches": {
          "title": "What threat monitoring watches",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "threat-actors",
              "protective-techniques",
              "deployed-environment"
            ]
          },
          "x-enforces": [
            "REQ-DODI5000.90-0103",
            "REQ-DODI5000.90-0106"
          ]
        }
      },
      "title": "Monitoring of threat actor activity, new protective techniques and the deployed threat environment",
      "x-enforces": [
        "REQ-DODI5000.90-0065"
      ]
    },
    "metrics": {
      "title": "Monitoring metrics",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "measures",
          "frequency",
          "reported_to",
          "used_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MET-\\d{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "measures": {
            "type": "string",
            "minLength": 1
          },
          "frequency": {
            "$ref": "#/$defs/frequency"
          },
          "reported_to": {
            "title": "Officials each metric is reported to",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/persona_id"
            },
            "x-enforces": [
              "REQ-SP800-137-0045"
            ]
          },
          "used_by": {
            "title": "Monitor tasks that read or report the metric",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^M-[1-7]$"
            },
            "x-enforces": [
              "REQ-SP800-137-0111"
            ]
          }
        }
      },
      "x-enforces": [
        "REQ-SP800-137-0123"
      ]
    },
    "delegations": {
      "title": "Operations and sustainment activities delegated to external partners",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activity",
          "partner",
          "agreement"
        ],
        "properties": {
          "activity": {
            "type": "string",
            "minLength": 1
          },
          "partner": {
            "title": "External partner: a persona or a leveraged authorization",
            "type": "string",
            "pattern": "^(PER-[A-Z0-9]+|LA-\\d{2,3})$",
            "x-enforces": [
              "REQ-DODI5000.87-0106"
            ]
          },
          "agreement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency",
        "triggers",
        "updates",
        "communicated_to"
      ],
      "properties": {
        "frequency": {
          "title": "How often the risk assessment is updated",
          "$ref": "#/$defs/frequency",
          "x-enforces": [
            "REQ-SP800-30R1-0227",
            "REQ-SP800-30R1-0229"
          ]
        },
        "triggers": {
          "title": "Circumstances under which the risk assessment is updated",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "x-enforces": [
            "REQ-SP800-30R1-0223",
            "REQ-SP800-30R1-0225",
            "REQ-SP800-30R1-0228"
          ]
        },
        "updates": {
          "title": "What an update of the risk assessment revises",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-30R1-0086",
            "REQ-SP800-30R1-0089",
            "REQ-SP800-30R1-0230"
          ]
        },
        "communicated_to": {
          "title": "Officials the results are communicated to",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/persona_id"
          }
        }
      },
      "title": "How the system risk assessment is maintained (from ART-ORG-CONTEXT)",
      "x-enforces": [
        "REQ-SP800-30R1-0029",
        "REQ-SP800-30R1-0226",
        "REQ-SP800-30R1-0297"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "information_needs",
        "measures",
        "procedures"
      ],
      "properties": {
        "information_needs": {
          "title": "Security-relevant information needs",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "need",
              "priority"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^NEED-\\d{2,3}$"
              },
              "need": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "title": "Priority of the information need",
                "enum": [
                  "high",
                  "moderate",
                  "low"
                ],
                "x-enforces": [
                  "REQ-SP800-160V1R1-1157"
                ]
              }
            }
          },
          "x-enforces": [
            "REQ-SP800-160V1R1-1150"
          ]
        },
        "measures": {
          "title": "Security measures selected to satisfy the needs",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "need",
              "description",
              "acceptable",
              "users"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^MSR-\\d{2,3}$"
              },
              "need": {
                "title": "Information need the measure satisfies",
                "type": "string",
                "pattern": "^NEED-\\d{2,3}$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "acceptable": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "title": "Acceptable parameters of security performance",
                "minProperties": 1
              },
              "users": {
                "title": "Measurement users",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/persona_id"
                },
                "minItems": 1
              }
            }
          }
        },
        "procedures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collection",
            "analysis",
            "access",
            "reporting"
          ],
          "properties": {
            "collection": {
              "type": "string",
              "minLength": 1
            },
            "analysis": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "type": "string",
              "minLength": 1
            },
            "reporting": {
              "type": "string",
              "minLength": 1
            }
          },
          "title": "Procedures for the collection, analysis, access and reporting of security-relevant data",
          "x-enforces": [
            "REQ-SP800-160V1R1-1155",
            "REQ-SP800-160V1R1-1160"
          ]
        },
        "results": {
          "title": "Security measurement results",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "measure",
              "date",
              "value",
              "within_parameters",
              "analysis",
              "informed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^MRS-\\d{2,3}$"
              },
              "measure": {
                "title": "Measure the result is of",
                "type": "string",
                "pattern": "^MSR-\\d{2,3}$"
              },
              "date": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "within_parameters": {
                "title": "Whether system security performance is within acceptable parameters",
                "type": "boolean",
                "x-enforces": [
                  "REQ-SP800-160V1R1-1153",
                  "REQ-SP800-160V1R1-1169"
                ]
              },
              "analysis": {
                "type": "string",
                "minLength": 1
              },
              "informed": {
                "title": "Measurement users informed of the result",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/persona_id"
                }
              }
            }
          }
        }
      }
    },
    "minimum_review": {
      "title": "The system owner's review of whether the organization's minimum monitoring frequencies suffice for the system",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "sufficient",
        "date"
      ],
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^PER-[A-Z]+$"
        },
        "sufficient": {
          "type": "boolean"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "detection_coverage": {
      "title": "The asset classes continuous monitoring covers at all times to find anomalies, indicators of compromise and other potentially adverse events (SP 800-61r3 DE.CM)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_class",
          "means"
        ],
        "properties": {
          "asset_class": {
            "enum": [
              "networks",
              "physical-environment",
              "personnel-activity",
              "external-providers",
              "computing"
            ]
          },
          "means": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tuning": {
      "title": "How monitoring technologies are tuned to reduce false positives and false negatives to acceptable levels",
      "type": "string",
      "minLength": 1
    },
    "vulnerability_management": {
      "title": "The vulnerability management strategy of the system (S-5)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process",
        "supported_by",
        "identification",
        "tools",
        "scans",
        "patching",
        "log_repository",
        "sources"
      ],
      "properties": {
        "process": {
          "title": "Steps of the DoD vulnerability management process",
          "type": "array",
          "items": {
            "enum": [
              "identification",
              "analysis",
              "analysis-reporting",
              "remediation-mitigation",
              "verification-monitoring"
            ]
          },
          "uniqueItems": true
        },
        "supported_by": {
          "title": "Record of each management that supports the process",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configuration",
            "asset",
            "remediation",
            "mitigation"
          ],
          "properties": {
            "configuration": {
              "type": "string",
              "pattern": "^ART-[A-Z]+(?:-[A-Z]+)*$"
            },
            "asset": {
              "type": "string",
              "pattern": "^ART-[A-Z]+(?:-[A-Z]+)*$"
            },
            "remediation": {
              "type": "string",
              "pattern": "^ART-[A-Z]+(?:-[A-Z]+)*$"
            },
            "mitigation": {
              "type": "string",
              "pattern": "^ART-[A-Z]+(?:-[A-Z]+)*$"
            }
          }
        },
        "identification": {
          "title": "How the system identifies vulnerabilities",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scanning_reference",
            "identified_from",
            "cross_reference",
            "manual"
          ],
          "properties": {
            "scanning_reference": {
              "title": "Reference for vulnerability scanning",
              "enum": [
                "SP800-115"
              ]
            },
            "identified_from": {
              "title": "Where vulnerabilities are identified from",
              "type": "array",
              "items": {
                "enum": [
                  "cve",
                  "vendor-bulletins",
                  "scans",
                  "vdp",
                  "directed-actions",
                  "incident-history",
                  "risk-assessment",
                  "assessments"
                ]
              },
              "uniqueItems": true
            },
            "cross_reference": {
              "title": "What previous incident reports and logs are cross-referenced with",
              "type": "array",
              "items": {
                "enum": [
                  "cve",
                  "risk-assessment",
                  "vendor-bulletins"
                ]
              },
              "uniqueItems": true
            },
            "manual": {
              "title": "Identification done by hand, and why no automation does it",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "activity",
                  "reason"
                ],
                "properties": {
                  "activity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "tools": {
          "title": "Automated software vulnerability analysis tools and the life cycle phases each serves",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "phases"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "pattern": "^TOOL-\\d{2,3}$"
              },
              "phases": {
                "type": "array",
                "items": {
                  "enum": [
                    "development",
                    "operational-test",
                    "operations-sustainment",
                    "retirement"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        "scans": {
          "title": "Scheduled vulnerability scans",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "frequency"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "authenticated",
                  "non-authenticated"
                ]
              },
              "frequency": {
                "$ref": "#/$defs/frequency"
              }
            }
          }
        },
        "patching": {
          "title": "Where patches come from and how their reach is checked",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patch_sources",
            "coverage_scan",
            "noncompliant_devices"
          ],
          "properties": {
            "patch_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "covers",
                  "source"
                ],
                "properties": {
                  "covers": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "enum": [
                      "dod-enterprise",
                      "vendor",
                      "program"
                    ]
                  }
                }
              },
              "minItems": 1
            },
            "coverage_scan": {
              "title": "Scan of the reach of automated patching, to find its gaps",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool",
                "frequency"
              ],
              "properties": {
                "tool": {
                  "type": "string",
                  "pattern": "^TOOL-\\d{2,3}$"
                },
                "frequency": {
                  "$ref": "#/$defs/frequency"
                }
              }
            },
            "noncompliant_devices": {
              "title": "How non-compliant devices are found and brought into compliance",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "log_repository": {
          "title": "Central log repository or SIEM",
          "type": "string",
          "minLength": 1
        },
        "provider_plan": {
          "title": "A provider's vulnerability management plan, approved by the AO",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "approved_by",
            "date"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "approved_by": {
              "$ref": "#/$defs/persona_id"
            },
            "date": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "privacy": {
      "title": "Privacy continuous monitoring strategy and program (PRIV-006)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guidance_by",
        "guidance",
        "controls",
        "sources"
      ],
      "properties": {
        "guidance_by": {
          "$ref": "#/$defs/persona_id",
          "title": "Senior agency official for privacy who gave guidance on the ongoing monitoring of privacy controls"
        },
        "guidance": {
          "type": "string",
          "minLength": 1
        },
        "controls": {
          "title": "Privacy controls in the privacy continuous monitoring strategy, each with its assessment frequency",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control",
              "frequency",
              "origin"
            ],
            "properties": {
              "control": {
                "$ref": "#/$defs/control"
              },
              "frequency": {
                "$ref": "#/$defs/frequency",
                "title": "Organization-defined assessment frequency of the privacy control"
              },
              "origin": {
                "title": "In the organization's PCM strategy, or added to it for this system",
                "enum": [
                  "strategy",
                  "added"
                ]
              },
              "consultation": {
                "title": "Consultation of the senior agency official for privacy on a privacy control not in the PCM strategy",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "by",
                  "date",
                  "appropriate",
                  "sources"
                ],
                "properties": {
                  "by": {
                    "$ref": "#/$defs/persona_id"
                  },
                  "date": {
                    "$ref": "#/$defs/date"
                  },
                  "appropriate": {
                    "title": "Whether the SAOP found the control appropriate for the use case",
                    "type": "boolean"
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/source"
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "lifecycle_approach": {
      "title": "The risk-based lifecycle management approach of a software pathway program (DoDI 5000.87 3.2.b.(3)): what it addresses, what the backlogs capture, and when a vulnerability fix leaves the release cycle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addresses",
        "backlog_captures",
        "out_of_cycle",
        "sources"
      ],
      "properties": {
        "addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "backlog_captures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_cycle": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  },
  "$defs": {
    "family": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "control": {
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "frequency": {
      "enum": [
        "continuous",
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "semi-annually",
        "annually",
        "event-driven"
      ]
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
