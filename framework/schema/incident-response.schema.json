{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:incident-response",
  "title": "runs/<run-id>/artifacts/data/incident-response.yaml",
  "description": "The incident response plan record (S-4): the reporting path for each case, triage, recovery criteria and notifications. IRPT-001 and IRPT-002 judge it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reporting_paths",
    "triage",
    "recovery",
    "notifications",
    "sources"
  ],
  "properties": {
    "reporting_paths": {
      "title": "Reporting path for each case: reference, recipients, owner and timeline",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "reference",
          "recipients",
          "owner",
          "timeline"
        ],
        "properties": {
          "case": {
            "enum": [
              "classified-compromise",
              "classified-spillage",
              "cui-disclosure",
              "pii-loss",
              "cleared-contractor-loss",
              "cnssi-1010",
              "incident-to-ao",
              "dodin-deficiency",
              "federal-law-violation",
              "anomalous-user-activity",
              "space-events",
              "threats-and-vulnerabilities",
              "cssp-incident",
              "counterintelligence"
            ]
          },
          "applies": {
            "type": "boolean"
          },
          "not_applicable_rationale": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "recipients": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "timeline": {
            "type": "string",
            "minLength": 1
          },
          "identified_as": {
            "type": "string",
            "minLength": 1
          },
          "determines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "audit_data": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "x-enforces": [
        "REQ-CNSSP12-0062",
        "REQ-DODI5400.11-0070",
        "REQ-DODI5400.11-0105",
        "REQ-DODI5400.11-0124",
        "REQ-DODI8500.01-0151",
        "REQ-DODI8500.01-0156",
        "REQ-DTM-24-001-0192",
        "REQ-DTM-24-001-0222",
        "REQ-DTM-24-001-0228",
        "REQ-DTM-24-001-0237",
        "REQ-DTM-24-001-0239",
        "REQ-DTM-24-001-0240",
        "REQ-DTM-24-001-0241",
        "REQ-DTM-24-001-0242",
        "REQ-DTM-24-001-0244",
        "REQ-DTM-24-001-0246",
        "REQ-DTM-24-001-0247",
        "REQ-DTM-24-001-0253",
        "REQ-DTM-24-001-0254",
        "REQ-SP800-61R3-0226"
      ]
    },
    "triage": {
      "title": "Triage, escalation and handling",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedures",
        "risk_factors",
        "intake",
        "categories",
        "escalation",
        "tracked_fields",
        "incident_lead",
        "evidence",
        "containment_criteria"
      ],
      "properties": {
        "procedures": {
          "title": "Documented procedures for the most common incident types and urgent processes",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0058"
          ]
        },
        "risk_factors": {
          "title": "Risk evaluation factors behind triage, prioritization and escalation",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0143",
            "REQ-SP800-61R3-0209"
          ]
        },
        "intake": {
          "title": "Preliminary review of a report, and how third parties report incidents",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0212"
          ]
        },
        "categories": {
          "title": "Categorization by incident type and strategy selection",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0213",
            "REQ-SP800-61R3-0214"
          ]
        },
        "escalation": {
          "title": "How ongoing incidents are tracked and escalated or elevated",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0215"
          ]
        },
        "tracked_fields": {
          "title": "Fields tracked per incident",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "x-enforces": [
            "REQ-SP800-61R3-0210"
          ]
        },
        "incident_lead": {
          "title": "Incident lead who safeguards response records",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0220"
          ]
        },
        "evidence": {
          "title": "Evidence collection, retention and chain of custody",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0221"
          ]
        },
        "containment_criteria": {
          "title": "Containment and eradication criteria, including their duration",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0229",
            "REQ-SP800-61R3-0231",
            "REQ-SP800-61R3-0232"
          ]
        }
      }
    },
    "recovery": {
      "title": "Recovery criteria and verification",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_criteria",
        "authorizations",
        "action_selection",
        "asset_integrity",
        "restoration_order",
        "restored_integrity",
        "end_criteria"
      ],
      "properties": {
        "start_criteria": {
          "title": "Criteria that start recovery",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0216"
          ]
        },
        "authorizations": {
          "title": "Who is told and what authorizations recovery needs",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0235"
          ]
        },
        "action_selection": {
          "title": "How recovery actions are selected, scoped and reassessed",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0236"
          ]
        },
        "asset_integrity": {
          "title": "Integrity checks on backups and restoration assets before use",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0237"
          ]
        },
        "restoration_order": {
          "title": "Order of restoration and post-restoration monitoring",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0238"
          ]
        },
        "restored_integrity": {
          "title": "Integrity checks on restored assets before production use",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0239"
          ]
        },
        "end_criteria": {
          "title": "Criteria that end recovery and the after-action report",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0240"
          ]
        }
      }
    },
    "notifications": {
      "title": "Who is told what and when",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_owners",
        "laws_and_agreements",
        "coordination",
        "recovery_communications",
        "public_updates"
      ],
      "properties": {
        "asset_owners": {
          "title": "Affected asset owners kept up to date",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0048"
          ]
        },
        "laws_and_agreements": {
          "title": "Notification laws, regulations and agreements that apply",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0076",
            "REQ-SP800-61R3-0225"
          ]
        },
        "coordination": {
          "title": "How affected parties are coordinated with, and information shared",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0224",
            "REQ-SP800-61R3-0227"
          ]
        },
        "recovery_communications": {
          "title": "Recovery progress updates to stakeholders and senior leadership",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0244"
          ]
        },
        "public_updates": {
          "title": "Public updates using approved methods and messaging",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0245"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "detection": {
      "title": "How adverse events are detected and analyzed: the cyber threat intelligence used, where it is used, and how events are correlated across sources (SP 800-61r3 DE.AE)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cti_sources",
        "cti_used_in",
        "correlation"
      ],
      "properties": {
        "cti_sources": {
          "title": "Sources of up-to-date cyber threat intelligence",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cti_used_in": {
          "title": "Where CTI is used: log analysis tools, correlation of events among log sources, adverse event analysis",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "log-analysis",
              "correlation",
              "adverse-event-analysis"
            ]
          }
        },
        "correlation": {
          "title": "How information from multiple sources is gathered and correlated, such as SIEM or SOAR",
          "type": "string",
          "minLength": 1
        },
        "estimates": {
          "title": "How the impact and scope of adverse events are estimated and refined",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-SP800-61R3-0203"
          ]
        }
      }
    },
    "plan_approval": {
      "title": "The plan's approval: who approved which version and when; a completed POA&M milestone that approves the plan finds it here (MPOA-001)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "date"
      ],
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^PER-[A-Z0-9]+$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "date": {
      "description": "ISO date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
