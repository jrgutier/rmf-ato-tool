{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:rar",
  "title": "runs/<run-id>/artifacts/data/rar.yaml",
  "description": "Risk assessment report data (R-2; updated by R-3). Risk to finding/POA&M linkage is RAR-001.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risks",
    "overall_risk",
    "sources"
  ],
  "properties": {
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "likelihood",
          "impact",
          "level",
          "finding_refs",
          "poam_refs",
          "response",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RSK-\\d{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "likelihood": {
            "$ref": "#/$defs/level"
          },
          "impact": {
            "$ref": "#/$defs/level"
          },
          "level": {
            "$ref": "#/$defs/level"
          },
          "finding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(FND|STG)-\\d{3}$"
            },
            "uniqueItems": true
          },
          "poam_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^POAM-\\d{3}$"
            },
            "uniqueItems": true
          },
          "response": {
            "enum": [
              "accept",
              "mitigate",
              "avoid",
              "share",
              "transfer"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "overall_risk": {
      "$ref": "#/$defs/level"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "level": {
      "description": "SP 800-30 qualitative scale.",
      "enum": [
        "very-low",
        "low",
        "moderate",
        "high",
        "very-high"
      ]
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
