{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:ssp-controls",
  "title": "runs/<run-id>/artifacts/ssp/controls/<fam>[.<n>].yaml",
  "description": "SSP control statements for one family or chunk (S-4; updated by I-2, M-4), written whole (INV-8). Coverage and duplicates are SSP-COV-001/SSP-DUP-001; status rules are SSP-STAT-001; assurance is SSE-003.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family",
    "controls"
  ],
  "properties": {
    "family": {
      "$ref": "#/$defs/family"
    },
    "chunk": {
      "type": "integer",
      "minimum": 1
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "status",
          "statement",
          "responsible_roles",
          "components",
          "sources"
        ],
        "properties": {
          "control_id": {
            "$ref": "#/$defs/control_id"
          },
          "status": {
            "enum": [
              "implemented",
              "partial",
              "planned",
              "alternative",
              "not-applicable",
              "inherited"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "responsible_roles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/persona_id"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/component_ref"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "inherited_from": {
            "description": "Provider of an inherited control: a leveraged authorization or common control provider.",
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "planned_io": {
            "title": "Planned inputs, related data sources and expected system outputs of a technical control",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-18R2-0187"
            ]
          },
          "technical_objectives": {
            "title": "Additional technical objectives the implementation addresses",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-18R2-0188"
            ]
          },
          "automation": {
            "title": "Reliance on automation for control monitoring, with performance thresholds",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-18R2-0189"
            ]
          },
          "artifact_locations": {
            "title": "Location of the policy, procedure and other artifacts referenced by the implementation",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "x-enforces": [
              "REQ-SP800-18R2-0100",
              "REQ-SP800-18R2-0191",
              "REQ-SP800-18R2-0192"
            ]
          },
          "information_sources": {
            "title": "Sources of information relevant to the control, such as monitoring, scanning and GRC tools",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "x-enforces": [
              "REQ-SP800-18R2-0193"
            ]
          },
          "inherited_risks": {
            "title": "Inherited risks from the common control implementations",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-18R2-0195"
            ]
          },
          "assurance": {
            "title": "How the assurance requirements of a control that contributes to assurance are addressed, and whether they are satisfied",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addressed",
              "status"
            ],
            "properties": {
              "addressed": {
                "title": "How the assurance requirements of the control are addressed when it is implemented: the developer and implementer activities and the evidence they produce",
                "type": "string",
                "minLength": 1,
                "x-enforces": [
                  "REQ-SP800-37R2-0331",
                  "REQ-SP800-39-0121"
                ]
              },
              "status": {
                "title": "Whether the minimum assurance requirements of the control are satisfied",
                "enum": [
                  "satisfied",
                  "not-satisfied",
                  "planned"
                ]
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "component_ref": {
      "type": "string",
      "pattern": "^(CMP-[A-Z0-9-]+|this-system)$"
    },
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
