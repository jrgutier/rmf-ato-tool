{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:overlay-specs",
  "title": "framework/baselines/overlay-specs.yaml (generated)",
  "description": "Section 6 of each transcribed CNSSI 1253 overlay, per control: the justification, guidance, control extension, parameter values and regulatory/statutory references, written by `uv run python -m rmf_tool.overlay_specs` and checked against the overlay's summary table (never hand-edited, INV-2). Read by OVS-001 to OVS-003 and `rmf catalog show --fields overlay`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["overlays"],
  "properties": {
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["overlay", "specs"],
        "properties": {
          "overlay": {"type": "string", "pattern": "^CNSSI1253[A-Z]?-[A-Z0-9-]+$"},
          "specs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["control", "heading", "citation"],
              "properties": {
                "control": {"type": "string", "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"},
                "heading": {"type": "string", "minLength": 1},
                "citation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ref", "page", "anchor"],
                  "properties": {
                    "ref": {"type": "string", "minLength": 1},
                    "page": {"type": "integer", "minimum": 1},
                    "anchor": {"type": "string", "minLength": 1}
                  }
                },
                "in_privacy_baseline": {
                  "description": "The Privacy Overlays print the control only as included in the NSS privacy control baseline, with no specification.",
                  "const": true
                },
                "statements": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "text"],
                    "properties": {
                      "kind": {"enum": ["justification", "extension", "guidance", "parameter"]},
                      "disposition": {
                        "description": "On a justification: select (+), not-select (--) or recommend (a Privacy Enhancing control, optional).",
                        "enum": ["select", "not-select", "recommend"]
                      },
                      "sets": {
                        "description": "The Privacy Overlays control sets the statement applies to; absent, every set the control is specified for.",
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"enum": ["ACCT", "LOW", "MODERATE", "HIGH", "ENHANCING"]}
                      },
                      "text": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "references": {"type": "string", "minLength": 1},
                "authorities": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
