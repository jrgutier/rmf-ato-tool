{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:authorizations",
  "title": "runs/<run-id>/artifacts/data/authorizations.yaml",
  "description": "The authorization ledger behind ART-AUTHREC (A-2; updated by R-4 and M-6). One record per decision; a later decision is a new record, so a cATO, a continuation or a rescission never overwrites the authorization beneath it. An empty list is valid until a decision exists. AODM-001 to AODM-011, AOCHG-001, OAUTH-001, OMP-002, ENT-001 and MISCM-001 judge the records, the issues raised, the Enterprise boardings and the ISCM program assessments read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "issues": {
      "title": "Authorization issues and disputes raised, and where each went",
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "boardings": {
      "title": "Enterprise system boardings at the DSAWG and the DoD ISRMC",
      "type": "array",
      "items": {
        "$ref": "#/$defs/boarding"
      }
    },
    "system_status": {
      "title": "What the security plan states of this system's authorization",
      "description": "Written whole with the ledger by each task that records a decision; SSPR-001 compares it with what the records hold.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "title": "Authorization Status of the system",
          "enum": [
            "ATO",
            "ATO-with-conditions",
            "IATT",
            "DATO",
            "none"
          ],
          "x-enforces": [
            "REQ-SP800-18R2-0241",
            "REQ-SP800-18R2-0341"
          ]
        },
        "termination_date": {
          "title": "Authorization Termination Date",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "security_review_date": {
          "title": "Security Review Date, the date of the last annual security review",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "iscm_assessments": {
      "title": "ISCM program assessment reports a decision reads (EXT-ISCM-ASSESSMENT)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/iscm_assessment"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "level": {
      "description": "SP 800-30 qualitative scale.",
      "enum": [
        "very-low",
        "low",
        "moderate",
        "high",
        "very-high"
      ]
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "decision",
        "subject",
        "basis",
        "decided_by",
        "task",
        "date",
        "risk_level",
        "risk_acceptance",
        "signature",
        "conveyed_to",
        "rationale",
        "sources"
      ],
      "properties": {
        "id": {
          "title": "Record ID, never reused within a ledger",
          "type": "string",
          "pattern": "^AUTH-\\d{3}$"
        },
        "decision": {
          "title": "Authorization decision type",
          "description": "An AD-* entry of framework/decisions.yaml: authorization to operate, authorization to use, common control authorization, a denial of each, and the rest.",
          "type": "string",
          "pattern": "^AD-[A-Z]{2,6}$",
          "x-enforces": [
            "REQ-CNSSI1254-0104",
            "REQ-SP800-37R2-0576",
            "REQ-SP800-37R2-0596"
          ]
        },
        "subject": {
          "title": "What the decision covers",
          "description": "The system, or the common controls offered for inheritance.",
          "enum": [
            "system",
            "common-controls"
          ]
        },
        "basis": {
          "title": "Why this decision is being taken",
          "description": "initial, reauthorization, ongoing authorization time-driven or event-driven trigger, change of authorizing official, or revocation.",
          "enum": [
            "test",
            "initial",
            "reauthorization",
            "time-driven",
            "event-driven",
            "ao-change",
            "revocation"
          ],
          "x-enforces": [
            "REQ-SP800-18R2-0355",
            "REQ-SP800-37R2-0543",
            "REQ-SP800-37R2-0546",
            "REQ-SP800-37R2-0610",
            "REQ-SP800-37R2-0630"
          ]
        },
        "decided_by": {
          "$ref": "#/$defs/persona_id",
          "title": "Authorizing official who explicitly accepts the risk"
        },
        "task": {
          "title": "RMF task that recorded the decision",
          "type": "string",
          "pattern": "^[PCSIARM]-[1-9]\\d?$"
        },
        "date": {
          "$ref": "#/$defs/date",
          "title": "Date the authorizing official signed the decision",
          "x-enforces": [
            "REQ-CNSSI1254-0106"
          ]
        },
        "risk_level": {
          "$ref": "#/$defs/level",
          "title": "Overall risk level the decision accepts",
          "description": "The risk to organizational operations and assets, individuals, other organizations and the Nation."
        },
        "risk_acceptance": {
          "title": "The authorizing official's explicit statement on the risk",
          "description": "That the official understands and accepts the residual risk to organizational operations and assets, individuals, other organizations and the Nation, or finds it unacceptable, for continued operation or use.",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-CNSSI1254-0105"
          ]
        },
        "signature": {
          "title": "How the authorizing official signed the decision document",
          "description": "Manual signature or Public Key Infrastructure certified digital signature.",
          "enum": [
            "manual",
            "pki"
          ],
          "x-enforces": [
            "REQ-CNSSI1254-0105"
          ]
        },
        "conveyed_to": {
          "title": "Officials the decision is conveyed to",
          "description": "The system owner or common control provider and other organizational officials who receive the authorization decision.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/persona_id"
          },
          "minItems": 1
        },
        "rationale": {
          "title": "Why the authorizing official decided this",
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "authorization_termination_date": {
          "$ref": "#/$defs/date"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^COND-\\d{2}$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "due": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "rar_ref": {
          "const": "ART-RAR"
        },
        "degraded_disclosure": {
          "type": "string",
          "minLength": 1
        },
        "underlying": {
          "title": "Record this one modifies, continues or revokes",
          "type": "string",
          "pattern": "^AUTH-\\d{3}$"
        },
        "supersedes": {
          "title": "Record this one replaces at reauthorization or a change of authorizing official",
          "type": "string",
          "pattern": "^AUTH-\\d{3}$"
        },
        "initiation_inputs": {
          "title": "Inputs to the decision to initiate a formal reauthorization",
          "description": "One per official whose input the decision to reauthorize includes. OMP-002 reads it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "date"
            ],
            "properties": {
              "by": {
                "title": "Official who gave input to the decision to reauthorize",
                "$ref": "#/$defs/persona_id"
              },
              "date": {
                "title": "Date of the input",
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "review": {
          "title": "When the authorizing official reviews the authorization",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frequency_days",
            "events"
          ],
          "properties": {
            "frequency_days": {
              "title": "Time-driven authorization frequency in days",
              "type": "integer",
              "minimum": 1,
              "x-enforces": [
                "REQ-SP800-37R2-0578",
                "REQ-SP800-37R2-0610",
                "REQ-SP800-37R2-0622"
              ]
            },
            "events": {
              "title": "Event-driven triggers for review",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "x-enforces": [
                "REQ-SP800-37R2-0625",
                "REQ-SP800-37R2-0635"
              ]
            }
          }
        },
        "trigger": {
          "title": "Event that triggered an event-driven review",
          "description": "Who raised it (organizational personnel, an automated tool, or the authorizing official on their own determination) and when. OAUTH-001 reads it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "raised_by",
            "date"
          ],
          "properties": {
            "event": {
              "title": "Trigger event that occurred",
              "type": "string",
              "minLength": 1
            },
            "raised_by": {
              "title": "Who notified the authorizing official of the trigger event",
              "anyOf": [
                {
                  "$ref": "#/$defs/persona_id"
                },
                {
                  "const": "automated-tool"
                }
              ]
            },
            "date": {
              "title": "Date the trigger event was raised",
              "$ref": "#/$defs/date"
            }
          }
        },
        "cio_concurrence": {
          "title": "Component CIO concurrence or non-concurrence",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "position",
            "date"
          ],
          "properties": {
            "by": {
              "$ref": "#/$defs/persona_id"
            },
            "position": {
              "enum": [
                "concur",
                "non-concur"
              ]
            },
            "date": {
              "$ref": "#/$defs/date"
            },
            "directions": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "threat_assessment": {
          "title": "Intelligence Community threat assessment the PM reviewed",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issued_by",
            "issued",
            "reviewed_by",
            "reviewed",
            "sources"
          ],
          "properties": {
            "issued_by": {
              "type": "string",
              "minLength": 1,
              "title": "Intelligence Community body that issued the threat assessment",
              "x-enforces": [
                "REQ-DODI5000.90-0081"
              ]
            },
            "issued": {
              "$ref": "#/$defs/date",
              "title": "Date the threat assessment was issued",
              "x-enforces": [
                "REQ-DODI5000.90-0081"
              ]
            },
            "reviewed_by": {
              "$ref": "#/$defs/persona_id"
            },
            "reviewed": {
              "$ref": "#/$defs/date"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "dod_ciso_approval": {
          "title": "DoD CISO approval of the cATO",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "reference"
          ],
          "properties": {
            "date": {
              "$ref": "#/$defs/date",
              "title": "Date of the DoD CISO approval",
              "x-enforces": [
                "REQ-DODCIO-CATO-0010"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "component_ciso_notification": {
          "title": "The AO's notice to the Component CISO of the intent to move to a cATO",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date"
          ],
          "properties": {
            "date": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "provider": {
          "title": "Provider organization whose authorization package a customer accepts",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization",
            "decision",
            "date",
            "package"
          ],
          "properties": {
            "organization": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "enum": [
                "AD-ATO",
                "AD-ATOC"
              ]
            },
            "date": {
              "$ref": "#/$defs/date",
              "title": "Date of the provider's authorization to operate",
              "x-enforces": [
                "REQ-DODCIO-RECIPROCITY-0012",
                "REQ-DODCIO-RECIPROCITY-0058",
                "REQ-SP800-37R2-0574",
                "REQ-SP800-37R2-0580",
                "REQ-SP800-37R2-0581",
                "REQ-SP800-37R2-0588",
                "REQ-SP800-37R2-0593"
              ]
            },
            "package": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ongoing_acknowledgment": {
          "title": "The AO's acceptance of the ongoing authorization process",
          "type": "string",
          "minLength": 1
        },
        "revocation_reason": {
          "title": "Why the authorization or cATO was revoked",
          "enum": [
            "poor-posture",
            "risk-tolerance",
            "incident",
            "other"
          ]
        },
        "ao_transfer": {
          "title": "Transfer of responsibility to a new authorizing official",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outgoing",
            "incoming",
            "reviewed",
            "risk_finding",
            "response",
            "accepts_risk_to"
          ],
          "properties": {
            "outgoing": {
              "type": "string",
              "minLength": 1
            },
            "reviewed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "incoming": {
              "title": "New authorizing official who takes the responsibility and accountability",
              "type": "string",
              "minLength": 1
            },
            "risk_finding": {
              "title": "What the new authorizing official finds the current risk to be",
              "enum": [
                "acceptable",
                "unacceptable"
              ]
            },
            "response": {
              "title": "What the new authorizing official does about that finding",
              "enum": [
                "signed-decision",
                "authorization-action",
                "new-terms",
                "denial"
              ]
            },
            "action": {
              "title": "Authorization action initiated",
              "enum": [
                "ongoing-authorization",
                "reauthorization"
              ]
            },
            "accepts_risk_to": {
              "title": "What the new authorizing official explicitly accepts the risk to",
              "type": "array",
              "items": {
                "enum": [
                  "organizational-operations",
                  "organizational-assets",
                  "individuals",
                  "other-organizations",
                  "the-nation"
                ]
              }
            }
          }
        },
        "risk_executive": {
          "title": "Consultation of the risk executive (function) before the final decision",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "consulted",
            "analyzed_by",
            "sources"
          ],
          "properties": {
            "by": {
              "$ref": "#/$defs/persona_id",
              "title": "Risk executive (function) the authorizing official consulted before the final decision",
              "x-enforces": [
                "REQ-SP800-37R2-0410"
              ]
            },
            "consulted": {
              "$ref": "#/$defs/date",
              "title": "Date the authorizing official consulted the risk executive (function)"
            },
            "analyzed_by": {
              "$ref": "#/$defs/persona_id",
              "title": "Official who analyzed the risk executive (function) input"
            },
            "input": {
              "type": "string",
              "minLength": 1,
              "title": "Risk executive (function) input, the security considerations the authorizing official deems relevant to the authorization decision"
            },
            "input_relevant": {
              "title": "Whether the input from R-2 is relevant to this decision",
              "type": "boolean"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "privacy_coordination": {
          "title": "The privacy official's review of the authorization package and coordination on the decision, for a system processing PII (AODM-010)",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "date",
            "sources"
          ],
          "properties": {
            "by": {
              "$ref": "#/$defs/persona_id",
              "title": "Senior component official for privacy who coordinated on the authorization decision"
            },
            "date": {
              "$ref": "#/$defs/date",
              "title": "Date the privacy official reviewed the authorization package, on or before the decision"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "deployment": {
          "title": "What the authorization deploys",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "title": "Whether the authorization is for an Enterprise system, deployed to multiple DoD Components",
              "enum": [
                "component",
                "enterprise"
              ],
              "x-enforces": [
                "REQ-DODCIO-RECIPROCITY-0037"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "title": "Version of the Enterprise system being deployed"
            },
            "boarding": {
              "title": "Boarding whose ISRMC approval the ATO rests on",
              "type": "string",
              "pattern": "^BRD-\\d{3}$"
            }
          }
        },
        "iscm_assessment": {
          "title": "ISCM program assessment this decision reads",
          "type": "string",
          "pattern": "^ISCMA-\\d{3}$"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "summary",
        "raised",
        "forum",
        "status",
        "sources"
      ],
      "properties": {
        "id": {
          "title": "Issue ID, never reused",
          "type": "string",
          "pattern": "^ISS-\\d{3}$"
        },
        "kind": {
          "title": "Kind of authorization issue or dispute",
          "enum": [
            "mission-area",
            "space-system",
            "community-risk",
            "process-dispute",
            "dsawg-appeal",
            "isrmc-direction"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "title": "What the authorization issue is"
        },
        "raised": {
          "$ref": "#/$defs/date",
          "title": "Date the issue was raised or the direction issued"
        },
        "forum": {
          "title": "Who resolves the authorization issue",
          "description": "PAO: the Principal Authorizing Official of the mission area. USSPACECOM: space systems. DSAWG: shared community risk. DOD-CISO: the DoD CISO's escalation procedures. ISRMC: an appeal of a DSAWG decision, or direction the ISRMC issued.",
          "enum": [
            "PAO",
            "USSPACECOM",
            "DSAWG",
            "DOD-CISO",
            "ISRMC"
          ]
        },
        "status": {
          "title": "Whether the issue is open or resolved",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolved": {
          "$ref": "#/$defs/date",
          "title": "Date the issue was resolved or the direction complied with"
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "title": "How the issue was resolved"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "boarding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "dsawg_submission",
        "isrmc",
        "sources"
      ],
      "properties": {
        "id": {
          "title": "Boarding ID, never reused",
          "type": "string",
          "pattern": "^BRD-\\d{3}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "title": "Version of the Enterprise system being deployed"
        },
        "reboarding_of": {
          "title": "Boarding this one follows: a disapproval, or a change in risk that cannot be mitigated",
          "type": "string",
          "pattern": "^BRD-\\d{3}$"
        },
        "dsawg_submission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "documents",
            "sites"
          ],
          "properties": {
            "date": {
              "$ref": "#/$defs/date",
              "title": "Date of the DSAWG submission"
            },
            "documents": {
              "title": "Core documents provided to the DSAWG",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^ART-[A-Z]+$"
              },
              "uniqueItems": true
            },
            "sites": {
              "title": "Deployment sites and projected deployment dates",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "site",
                  "deployment"
                ],
                "properties": {
                  "site": {
                    "type": "string",
                    "minLength": 1
                  },
                  "deployment": {
                    "$ref": "#/$defs/date"
                  }
                }
              }
            }
          }
        },
        "status_briefs": {
          "title": "Authorization status briefs the DSAWG requested",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requested"
            ],
            "properties": {
              "requested": {
                "$ref": "#/$defs/date",
                "title": "Date the DSAWG requested the brief"
              },
              "briefed": {
                "$ref": "#/$defs/date",
                "title": "Date the brief was given"
              }
            }
          }
        },
        "dsawg_recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "position"
          ],
          "properties": {
            "date": {
              "$ref": "#/$defs/date",
              "title": "Date of the DSAWG recommendation"
            },
            "position": {
              "enum": [
                "recommend",
                "do-not-recommend"
              ]
            }
          }
        },
        "isrmc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "briefed",
            "planned_deployment",
            "outcome"
          ],
          "properties": {
            "briefed": {
              "$ref": "#/$defs/date",
              "title": "Date the ISRMC was briefed"
            },
            "planned_deployment": {
              "$ref": "#/$defs/date",
              "title": "Planned deployment date"
            },
            "outcome": {
              "title": "ISRMC approval or disapproval",
              "enum": [
                "pending",
                "approved",
                "disapproved"
              ]
            },
            "decided": {
              "$ref": "#/$defs/date",
              "title": "Date of the ISRMC decision"
            },
            "guidance_via": {
              "title": "Body through which ISRMC guidance reached the Granting organization",
              "enum": [
                "DSAWG",
                "direct"
              ]
            },
            "guidance": {
              "type": "string",
              "minLength": 1,
              "title": "ISRMC guidance on actions and mitigations"
            },
            "directed_risks": {
              "title": "Remaining risks the ISRMC directed be documented and mitigated in the POA&M",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^POAM-\\d{3}$"
              },
              "uniqueItems": true
            },
            "monitored_by": {
              "title": "Who monitors the acceptability of the residual risk at Component sites",
              "enum": [
                "ISRMC",
                "granting-organization"
              ]
            },
            "dodin_connection": {
              "title": "Whether connection to the DoD Information Network is authorized",
              "enum": [
                "authorized",
                "not-authorized"
              ]
            }
          }
        },
        "adjustments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worked_with",
            "changes"
          ],
          "properties": {
            "worked_with": {
              "title": "Body the Granting AO worked with to adjust the Enterprise system",
              "enum": [
                "DSAWG",
                "none"
              ]
            },
            "changes": {
              "type": "string",
              "minLength": 1,
              "title": "How the system was adjusted to comply with ISRMC guidance"
            }
          }
        },
        "risk_changes": {
          "title": "Changes in the acceptability of risk after approval",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "description",
              "mitigated"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "mitigated": {
                "type": "boolean"
              },
              "reboarding": {
                "type": "string",
                "pattern": "^BRD-\\d{3}$"
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "iscm_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assessors",
        "executive_sponsor",
        "parties_considered",
        "expectations",
        "draft",
        "final",
        "results",
        "recommendations",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ISCMA-\\d{3}$"
        },
        "assessors": {
          "type": "string",
          "minLength": 1
        },
        "executive_sponsor": {
          "$ref": "#/$defs/persona_id",
          "title": "Executive sponsor of the ISCM program assessment"
        },
        "parties_considered": {
          "title": "Parties whose needs the assessment considered",
          "type": "array",
          "items": {
            "$ref": "#/$defs/persona_id"
          }
        },
        "expectations": {
          "title": "Expectations set with the organization",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "date"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "before",
                  "during",
                  "after"
                ]
              },
              "date": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presented",
            "reviewed_by",
            "reviewed"
          ],
          "properties": {
            "presented": {
              "$ref": "#/$defs/date"
            },
            "reviewed_by": {
              "title": "Leadership who reviewed the draft report",
              "type": "array",
              "items": {
                "$ref": "#/$defs/persona_id"
              }
            },
            "reviewed": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "final": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presented",
            "presented_to"
          ],
          "properties": {
            "presented": {
              "$ref": "#/$defs/date"
            },
            "presented_to": {
              "title": "Who received the final report of findings",
              "type": "array",
              "items": {
                "$ref": "#/$defs/persona_id"
              }
            }
          }
        },
        "differences": {
          "title": "Differences of opinion between the assessors and the organization",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issue",
              "status"
            ],
            "properties": {
              "issue": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "open",
                  "resolved"
                ]
              }
            }
          }
        },
        "results": {
          "title": "Assessment results per element",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element",
              "judgment"
            ],
            "properties": {
              "element": {
                "type": "string",
                "minLength": 1
              },
              "judgment": {
                "enum": [
                  "satisfied",
                  "other-than-satisfied"
                ]
              },
              "score": {
                "type": "number"
              },
              "further_action": {
                "type": "string",
                "pattern": "^REC-\\d{2}$"
              }
            }
          }
        },
        "overall_score": {
          "title": "Single score for the organization or the part assessed",
          "type": "number"
        },
        "recommendations": {
          "title": "Recommendations based on the data collected and analyzed",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "based_on"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^REC-\\d{2}$"
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "based_on": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  }
}
