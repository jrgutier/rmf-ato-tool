{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:leveraged-authorizations",
  "title": "runs/<run-id>/artifacts/data/leveraged-authorizations.yaml",
  "description": "Authorizations this system inherits from (C-1); OSCAL SSP system-implementation.leveraged-authorizations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leveraged_authorizations"
  ],
  "properties": {
    "leveraged_authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "provider",
          "date_authorized",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LA-\\d{2,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "date_authorized": {
            "$ref": "#/$defs/date"
          },
          "decision": {
            "type": "string",
            "pattern": "^AD-[A-Z]{2,6}$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
