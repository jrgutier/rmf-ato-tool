{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:leveraged-authorizations",
  "title": "runs/<run-id>/artifacts/data/leveraged-authorizations.yaml",
  "description": "Authorizations this system inherits from (C-1); OSCAL SSP system-implementation.leveraged-authorizations. `enterprise` marks an Enterprise system this organization receives; ENT-002 judges it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leveraged_authorizations"
  ],
  "properties": {
    "leveraged_authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "provider",
          "date_authorized",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LA-\\d{2,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "date_authorized": {
            "$ref": "#/$defs/date"
          },
          "decision": {
            "type": "string",
            "pattern": "^AD-[A-Z]{2,6}$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "enterprise": {
            "title": "An Enterprise system this organization receives",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accepted_by",
              "accepted",
              "receiving_action",
              "change_request"
            ],
            "properties": {
              "accepted_by": {
                "title": "Body that made the enterprise level risk acceptance",
                "enum": [
                  "DoD ISRMC",
                  "Component"
                ]
              },
              "accepted": {
                "$ref": "#/$defs/date",
                "title": "Date of the risk acceptance"
              },
              "receiving_action": {
                "title": "What the receiving organization does with the Enterprise system",
                "enum": [
                  "deploy",
                  "refuse"
                ]
              },
              "change_request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "approved_on"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "approved_on": {
                    "title": "RMF artifact the change request was approved on",
                    "enum": [
                      "isrmc-risk-acceptance",
                      "local-assessment"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
