{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:tailoring",
  "title": "runs/<run-id>/artifacts/data/tailoring.yaml",
  "description": "Control tailoring actions (S-2; part of ART-BASELINE).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actions"
  ],
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "action",
          "rationale",
          "sources"
        ],
        "properties": {
          "control_id": {
            "$ref": "#/$defs/control_id"
          },
          "action": {
            "enum": [
              "add",
              "remove",
              "compensating",
              "parameter"
            ]
          },
          "compensating_for": {
            "$ref": "#/$defs/control_id"
          },
          "parameter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "param_id",
              "value"
            ],
            "properties": {
              "param_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
