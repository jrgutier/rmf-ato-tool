{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:dias",
  "title": "runs/<run-id>/artifacts/data/dias.yaml",
  "description": "Digital Identity Acceptance Statement (R-1): the assurance levels chosen with the ia family at S-4. DIAS-001 judges it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assurance",
    "controls",
    "processes",
    "compensating_controls",
    "sources"
  ],
  "properties": {
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_proofing",
        "authentication",
        "federation"
      ],
      "properties": {
        "identity_proofing": {
          "title": "Assurance level for identity proofing",
          "enum": [
            "IAL1",
            "IAL2",
            "IAL3",
            "not-applicable"
          ],
          "x-enforces": [
            "REQ-SP800-18R2-0239"
          ]
        },
        "authentication": {
          "title": "Assurance level for authentication",
          "enum": [
            "AAL1",
            "AAL2",
            "AAL3"
          ],
          "x-enforces": [
            "REQ-SP800-18R2-0239"
          ]
        },
        "federation": {
          "title": "Assurance level for federation, if applicable",
          "enum": [
            "FAL1",
            "FAL2",
            "FAL3",
            "not-applicable"
          ]
        }
      }
    },
    "controls": {
      "title": "Controls of the ia family these assurance levels rest on",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ia-\\d{1,2}(?:\\.\\d{1,2})?$"
      },
      "uniqueItems": true
    },
    "processes": {
      "type": "string",
      "minLength": 1,
      "title": "Processes and technologies selected to meet each assurance level"
    },
    "compensating_controls": {
      "title": "Compensating controls identified where a level cannot be met",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
