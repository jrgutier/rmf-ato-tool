{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:service-agreements",
  "title": "runs/<run-id>/artifacts/data/service-agreements.yaml",
  "description": "One agreement per cybersecurity service provider or other provider (S-4), monitored at M-2. SVCA-001 and SVCA-002 judge it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dodin_connected",
    "system_environments",
    "agreements",
    "sources"
  ],
  "properties": {
    "dodin_connected": {
      "title": "Whether the system connects to the DODIN; a system that does not has no CSSP alignment to show",
      "type": "boolean"
    },
    "system_environments": {
      "title": "Hosting environments of the system",
      "type": "array",
      "items": {
        "enum": [
          "on-premises",
          "cloud"
        ]
      }
    },
    "agreements": {
      "title": "One agreement per provider: instrument, services, controls and the subscriber check",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "role",
          "integration",
          "instrument",
          "reference",
          "environments",
          "scope",
          "parameters",
          "approved_by",
          "validation",
          "services",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "cssp",
              "cloud-service-provider",
              "common-control-provider",
              "other"
            ]
          },
          "integration": {
            "enum": [
              "external",
              "internal",
              "inherited"
            ]
          },
          "instrument": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "environments": {
            "type": "array",
            "items": {
              "enum": [
                "on-premises",
                "cloud"
              ]
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "authorized_by",
              "date"
            ],
            "properties": {
              "scheme": {
                "type": "string",
                "minLength": 1
              },
              "authorized_by": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "$ref": "#/$defs/date"
              }
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "date",
              "covers"
            ],
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "covers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "kind",
                "responsibilities",
                "controls"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "detection",
                    "vulnerability-detection",
                    "incident-response",
                    "monitoring",
                    "physical-protection",
                    "media-protection",
                    "supply-chain",
                    "identity",
                    "other"
                  ]
                },
                "responsibilities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "party",
                      "duty"
                    ],
                    "properties": {
                      "party": {
                        "enum": [
                          "service-provider",
                          "subscriber"
                        ]
                      },
                      "duty": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "controls": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/control_id"
                  }
                },
                "sensors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "effectiveness": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "service",
                "measured_by",
                "measure",
                "rating",
                "issue"
              ],
              "properties": {
                "date": {
                  "$ref": "#/$defs/date"
                },
                "service": {
                  "type": "string",
                  "minLength": 1
                },
                "measured_by": {
                  "type": "string",
                  "minLength": 1
                },
                "measure": {
                  "type": "string",
                  "minLength": 1
                },
                "rating": {
                  "enum": [
                    "effective",
                    "degraded",
                    "ineffective"
                  ]
                },
                "issue": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "none",
                        "open",
                        "resolved",
                        "unresolved"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reported_to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "resolved_by": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      },
      "x-enforces": [
        "REQ-DTM-24-001-0018",
        "REQ-DTM-24-001-0021",
        "REQ-DTM-24-001-0146",
        "REQ-DTM-24-001-0186",
        "REQ-DTM-24-001-0219",
        "REQ-SP800-61R3-0049"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "date": {
      "description": "ISO date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
