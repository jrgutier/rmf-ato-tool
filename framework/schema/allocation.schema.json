{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:allocation",
  "title": "runs/<run-id>/artifacts/data/allocation.yaml",
  "description": "Control allocation (S-3; part of ART-BASELINE): system-specific, hybrid or common, and the components that implement each control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allocations"
  ],
  "properties": {
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "type",
          "components",
          "sources"
        ],
        "properties": {
          "control_id": {
            "$ref": "#/$defs/control_id"
          },
          "type": {
            "enum": [
              "system-specific",
              "hybrid",
              "common"
            ]
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/component_ref"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "provider": {
            "description": "Common control provider (for common and hybrid).",
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "component_ref": {
      "type": "string",
      "pattern": "^(CMP-[A-Z0-9-]+|this-system)$"
    },
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
