{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:sap",
  "title": "runs/<run-id>/artifacts/data/sap.yaml",
  "description": "The agent-written part of the security assessment plan (A-2): scope exclusions, team, schedule, rules of engagement and test events. Reviewed controls and methods are derived from baseline.json and the catalog (plan §7.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "assessment_subjects",
    "team",
    "schedule",
    "rules_of_engagement",
    "sources"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "excluded_controls"
      ],
      "properties": {
        "include": {
          "const": "baseline",
          "title": "What the scope of the assessment includes: the whole baseline",
          "x-enforces": [
            "REQ-SP800-53AR5-0138"
          ]
        },
        "excluded_controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control_id",
              "rationale"
            ],
            "properties": {
              "control_id": {
                "$ref": "#/$defs/control_id"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "assessment_subjects": {
      "title": "The systems and components assessed within the authorization boundary, by type",
      "x-enforces": [
        "REQ-CNSSI1254-0070"
      ],
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "include"
        ],
        "properties": {
          "type": {
            "enum": [
              "component",
              "inventory-item",
              "location",
              "party",
              "user"
            ]
          },
          "include": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "persona",
          "role"
        ],
        "properties": {
          "persona": {
            "$ref": "#/$defs/persona_id"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "independent": {
            "type": "boolean"
          },
          "qualification": {
            "title": "The assessor's qualification, verified by the CISO who establishes and oversees the team",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis",
              "verified_by",
              "verified"
            ],
            "properties": {
              "basis": {
                "title": "What qualifies this cybersecurity professional to assess",
                "type": "string",
                "minLength": 1
              },
              "verified_by": {
                "title": "The CISO who establishes the team of qualified assessors",
                "$ref": "#/$defs/persona_id"
              },
              "verified": {
                "title": "When the qualification was verified",
                "$ref": "#/$defs/date"
              }
            }
          },
          "contract": {
            "title": "For contracted assessment services: whether the system or program owner is directly involved in the contracting process and can unduly influence the assessor's independence",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner_involved",
              "owner_can_influence"
            ],
            "properties": {
              "owner_involved": {
                "type": "boolean"
              },
              "owner_can_influence": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date",
          "title": "The date the assessment ends, the time frame for completing it",
          "x-enforces": [
            "REQ-SP800-53AR5-0142",
            "REQ-SP800-53AR5-0205"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "description"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "live": {
                "description": "The event runs on a live network or with live data, so it needs an AD-IATT or authorization in force (AODM-006).",
                "type": "boolean"
              },
              "kind": {
                "enum": [
                  "kickoff",
                  "dt-e",
                  "ot-e",
                  "scan",
                  "interview",
                  "out-brief",
                  "penetration-test",
                  "other"
                ]
              }
            }
          }
        }
      }
    },
    "rules_of_engagement": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "assessor_independence": {
      "title": "Required degree of assessor independence",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "determined_by",
        "rationale"
      ],
      "properties": {
        "required": {
          "title": "Degree of assessor independence the authorizing official requires",
          "enum": [
            "self-assessment",
            "internal",
            "independent"
          ]
        },
        "determined_by": {
          "title": "The authorizing official who determines the degree of independence",
          "$ref": "#/$defs/persona_id"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "title": "What the required level of independence rests on: the security categorization (ART-CAT) and the risk to operations, assets, individuals, other organizations and the Nation (ART-RA)",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ART-[A-Z]+(-[A-Z]+)*$"
          }
        },
        "sufficiency": {
          "title": "Whether the level of assessor independence is sufficient to provide confidence that the assessment results are sound",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "determined_by",
            "sufficient",
            "date"
          ],
          "properties": {
            "determined_by": {
              "title": "The authorizing official or designated representative who determined the sufficiency",
              "$ref": "#/$defs/persona_id"
            },
            "sufficient": {
              "type": "boolean"
            },
            "date": {
              "$ref": "#/$defs/date"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "achieved_by": {
          "title": "How independence is achieved: by the assessors themselves, or in special situations by an independent team of experts reviewing the results",
          "enum": [
            "assessor",
            "independent-review"
          ]
        },
        "review": {
          "title": "The independent team of experts that reviews and analyzes the assessment results when the assessors are in the system owner's chain",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "situation"
          ],
          "properties": {
            "by": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/persona_id"
              }
            },
            "situation": {
              "title": "The special situation: a small organization, or a structure that puts the assessors in the developmental, operational or management chain of the system owner",
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "objectives": {
      "title": "The objective of the control assessment",
      "type": "string",
      "minLength": 1
    },
    "level_of_effort": {
      "title": "The expected level of effort for the control assessments",
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "title": "Review and approval of the assessment plan",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_by",
        "approved_by",
        "date"
      ],
      "properties": {
        "reviewed_by": {
          "title": "The security control assessor who reviews the assessment plan",
          "$ref": "#/$defs/persona_id"
        },
        "approved_by": {
          "title": "The authorizing official or designated representative who approves the assessment plan",
          "$ref": "#/$defs/persona_id"
        },
        "date": {
          "title": "When the assessment plan was approved",
          "$ref": "#/$defs/date"
        }
      }
    },
    "preparation": {
      "title": "Preparation for the assessment (SP 800-53A section 3.1)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "informed_by",
        "officials_notified",
        "resources",
        "access",
        "documentation_provided",
        "elements",
        "channels",
        "points_of_contact",
        "ambiguity_mechanism",
        "understanding"
      ],
      "properties": {
        "informed_by": {
          "title": "The system owner who informs organizational officials of the assessment",
          "$ref": "#/$defs/persona_id"
        },
        "officials_notified": {
          "title": "Key organizational officials notified of the impending assessments",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "persona",
              "date"
            ],
            "properties": {
              "persona": {
                "$ref": "#/$defs/persona_id"
              },
              "date": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "resources": {
          "title": "Necessary resources allocated to the assessment",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allocated_by",
            "allocated",
            "description"
          ],
          "properties": {
            "allocated_by": {
              "title": "The system owner who ensures resources are available",
              "$ref": "#/$defs/persona_id"
            },
            "allocated": {
              "$ref": "#/$defs/date"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "access": {
          "title": "Assessor access to the system, its environment and the materials needed",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "to",
              "provided_by",
              "provided"
            ],
            "properties": {
              "to": {
                "title": "What assessors have access to",
                "enum": [
                  "system",
                  "environment",
                  "documentation",
                  "records",
                  "artifacts",
                  "test-results"
                ]
              },
              "provided_by": {
                "title": "The system owner who provides assessors the access",
                "$ref": "#/$defs/persona_id"
              },
              "provided": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "documentation_provided": {
          "title": "Documentation provided to the assessors",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ART-[A-Z]+(?:-[A-Z]+)*$"
          }
        },
        "elements": {
          "title": "Elements of the organization identified, with access arranged",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "responsible_for",
              "persona"
            ],
            "properties": {
              "responsible_for": {
                "title": "What this element of the organization develops, documents or updates",
                "type": "string",
                "minLength": 1
              },
              "persona": {
                "$ref": "#/$defs/persona_id"
              }
            }
          }
        },
        "channels": {
          "title": "Communication channels among organizational officials",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "among",
              "means"
            ],
            "properties": {
              "among": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/persona_id"
                }
              },
              "means": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "points_of_contact": {
          "title": "Organizational points of contact to carry out the assessments",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "persona",
              "for"
            ],
            "properties": {
              "persona": {
                "$ref": "#/$defs/persona_id"
              },
              "for": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "ambiguity_mechanism": {
          "title": "Mechanism to minimize ambiguities or misunderstandings",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "between",
            "means"
          ],
          "properties": {
            "between": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/persona_id"
              }
            },
            "means": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "understanding": {
          "title": "The assessors' understanding of the organization's operations",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "sources"
          ],
          "properties": {
            "summary": {
              "title": "General understanding of the organization's operations and how the system supports them",
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        }
      }
    },
    "reuse_policy": {
      "title": "The reuse requirements established by the organization",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_age_days",
        "source"
      ],
      "properties": {
        "max_age_days": {
          "title": "Oldest reusable result the organization's reuse policy allows, in days",
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "title": "The organization's reuse policy",
          "$ref": "#/$defs/source"
        }
      }
    },
    "reused_results": {
      "title": "Previous assessment results reused in this assessment",
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "type",
          "assessed",
          "criteria",
          "controls",
          "independence",
          "approved_by",
          "coordinated_with",
          "determined_by",
          "credibility",
          "appropriateness",
          "applicability",
          "currency",
          "relevance",
          "changes_since",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RR-\\d{3}$"
          },
          "source": {
            "title": "Testing resource or assessment the result comes from",
            "type": "string",
            "minLength": 1
          },
          "type": {
            "title": "Type of the original assessment",
            "enum": [
              "developmental-test",
              "operational-test",
              "ongoing-assessment",
              "previous-authorization",
              "common-control",
              "control-review",
              "iscm",
              "audit",
              "component-product"
            ]
          },
          "assessed": {
            "title": "Date of the original assessment",
            "$ref": "#/$defs/date"
          },
          "criteria": {
            "title": "Testing criteria and requirements used",
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/control_id"
            }
          },
          "independence": {
            "title": "Degree of independence of the previous assessment",
            "enum": [
              "self-assessment",
              "internal",
              "independent"
            ]
          },
          "approved_by": {
            "title": "The user of the assessment results who approves reusing them",
            "$ref": "#/$defs/persona_id"
          },
          "coordinated_with": {
            "title": "Officials who determine the acceptability of using previous assessment results",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/persona_id"
            }
          },
          "determined_by": {
            "title": "The assessor who determines credibility and applicability",
            "$ref": "#/$defs/persona_id"
          },
          "credibility": {
            "$ref": "#/$defs/verdict"
          },
          "appropriateness": {
            "$ref": "#/$defs/verdict"
          },
          "applicability": {
            "$ref": "#/$defs/verdict"
          },
          "currency": {
            "$ref": "#/$defs/verdict"
          },
          "relevance": {
            "$ref": "#/$defs/verdict"
          },
          "changes_since": {
            "title": "Changes since the previous assessment and their impact on the results",
            "type": "string",
            "minLength": 1
          },
          "supplement": {
            "title": "Additional assessment activities that supplement the result",
            "type": "string",
            "minLength": 1
          },
          "product_review": {
            "title": "Review of a component product's information",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "controls_implemented",
              "meets_requirements",
              "configuration_consistent",
              "assurance_satisfied"
            ],
            "properties": {
              "controls_implemented": {
                "type": "boolean"
              },
              "meets_requirements": {
                "type": "boolean"
              },
              "configuration_consistent": {
                "type": "boolean"
              },
              "assurance_satisfied": {
                "type": "boolean"
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "procedures": {
      "title": "Assessment procedures selected and tailored for the scoped controls",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "controls",
          "methods",
          "objects",
          "depth",
          "coverage",
          "rationale",
          "risk_results",
          "adaptation",
          "sequence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PRC-\\d{3}$"
          },
          "controls": {
            "title": "Controls this assessment procedure covers; several are a consolidation",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/control_id"
            }
          },
          "methods": {
            "title": "Assessment methods selected",
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "examine",
                "interview",
                "test"
              ]
            }
          },
          "objects": {
            "title": "Assessment objects selected",
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "specifications",
                "mechanisms",
                "activities",
                "individuals"
              ]
            }
          },
          "depth": {
            "title": "Depth attribute value of the assessment procedure",
            "enum": [
              "basic",
              "focused",
              "comprehensive"
            ],
            "x-enforces": [
              "REQ-SP800-53AR5-0171"
            ]
          },
          "coverage": {
            "title": "Coverage attribute value of the assessment procedure",
            "enum": [
              "basic",
              "focused",
              "comprehensive"
            ]
          },
          "rationale": {
            "title": "Rationale for selecting the methods and objects",
            "type": "string",
            "minLength": 1
          },
          "risk_results": {
            "title": "Risk assessment results applied to the tailoring",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "adaptation": {
            "title": "System, platform or organization specific adaptation of the procedure",
            "enum": [
              "none",
              "system-specific",
              "platform-specific",
              "organization-specific"
            ]
          },
          "adaptation_note": {
            "title": "How the procedure was adapted",
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "title": "Order of the procedure among the assessment procedures; procedures run together share one",
            "type": "integer",
            "minimum": 1
          },
          "assurance_requirement": {
            "title": "The assurance requirement of rigor.assurance_requirements the procedure meets",
            "type": "string",
            "pattern": "^AR-\\d{3}$"
          },
          "sampling": {
            "title": "One record per method: the type, number and specific objects the organization directs",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "types",
                "selection"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "examine",
                    "interview",
                    "test"
                  ]
                },
                "types": {
                  "title": "The object types sampled (an interview samples personas) and how many of each",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "number"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "number": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                "specific": {
                  "title": "Specific objects or individuals deemed particularly important, beside the representative sample",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "selection": {
                  "title": "How the sample is drawn",
                  "enum": [
                    "random",
                    "targeted",
                    "random-and-targeted"
                  ]
                },
                "bias_control": {
                  "title": "How bias is avoided when the sample is not random",
                  "type": "string",
                  "minLength": 1
                },
                "extent": {
                  "title": "For mechanism-related testing, the extent of the testing: what is counted and how many",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "measure",
                      "count"
                    ],
                    "properties": {
                      "measure": {
                        "type": "string",
                        "minLength": 1
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "optimization": {
      "title": "Optimization of the assessment procedures",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_by",
        "tailoring_guidance",
        "notes"
      ],
      "properties": {
        "reviewed_by": {
          "title": "The assessor who reviews the selected procedures to combine or consolidate them",
          "$ref": "#/$defs/persona_id"
        },
        "tailoring_guidance": {
          "title": "Additional tailoring guidance the organization provides",
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "title": "How the procedures were sequenced and consolidated",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "additional_procedures": {
      "title": "Additional assessment procedures for requirements outside SP 800-53",
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement",
          "statements",
          "methods",
          "objects",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^APR-\\d{3}$"
          },
          "requirement": {
            "title": "Security requirement or control not covered by SP 800-53",
            "type": "string",
            "minLength": 1
          },
          "statements": {
            "title": "Determination statements developed for it",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "examine",
                "interview",
                "test"
              ]
            }
          },
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "specifications",
                "mechanisms",
                "activities",
                "individuals"
              ]
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "external_providers": {
      "title": "External providers and how their controls are assessed",
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "kind",
          "under_usg_authority",
          "arrangement",
          "covers",
          "agreement_review",
          "procedure_adjustment",
          "provider_assessment",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EXT-\\d{3}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "title": "Whose system this is",
            "enum": [
              "usg",
              "commercial",
              "foreign-government"
            ]
          },
          "under_usg_authority": {
            "title": "Whether the system falls under existing USG authorities for authorization decisions",
            "type": "boolean"
          },
          "third_party": {
            "title": "Third party assessment organization acceptable to the AO",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "organization",
              "accepted_by",
              "accepted"
            ],
            "properties": {
              "organization": {
                "type": "string",
                "minLength": 1
              },
              "accepted_by": {
                "$ref": "#/$defs/persona_id"
              },
              "accepted": {
                "$ref": "#/$defs/date"
              }
            }
          },
          "arrangement": {
            "title": "The contract or agreement with the external provider",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "reference"
            ],
            "properties": {
              "type": {
                "title": "How the external provider is engaged",
                "enum": [
                  "contract",
                  "interagency-agreement",
                  "line-of-business",
                  "licensing",
                  "supply-chain"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "covers": {
            "title": "External boundary components and leveraged authorizations this provider stands behind",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "agreement_review": {
            "title": "Review of the contract or agreement",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "date",
              "assurances"
            ],
            "properties": {
              "by": {
                "title": "The assessor who reviews the contract or agreement",
                "$ref": "#/$defs/persona_id"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "assurances": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "procedure_adjustment": {
            "title": "Adjustment to the assessment procedures for this external provider",
            "type": "string",
            "minLength": 1
          },
          "provider_assessment": {
            "title": "The provider's assessment results, reviewed before leveraging",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "independence",
              "procedures_reviewed_by",
              "evidence",
              "meets_protection_needs",
              "other_assessments"
            ],
            "properties": {
              "scope": {
                "title": "Type, rigor and scope of the provider's assessment",
                "type": "string",
                "minLength": 1
              },
              "independence": {
                "title": "Independence of the assessors the provider used",
                "enum": [
                  "self-assessment",
                  "internal",
                  "independent"
                ]
              },
              "procedures_reviewed_by": {
                "title": "Who reviewed the assessment procedures the provider employed",
                "$ref": "#/$defs/persona_id"
              },
              "evidence": {
                "title": "State of the information the provider makes available",
                "enum": [
                  "received",
                  "requested",
                  "refused"
                ]
              },
              "meets_protection_needs": {
                "title": "Whether the provider's controls meet the protection needs of the organization",
                "type": "boolean"
              },
              "other_assessments": {
                "title": "Other assessments conducted or in progress for this external system",
                "type": "string",
                "minLength": 1
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "penetration_test": {
      "title": "The penetration test the plan schedules: its scope at the minimum SP 800-53A Appendix D lists, the assessor, the guidance and, on a cATO path, the environments and the kind of assessment",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "assessor",
        "guidance",
        "components"
      ],
      "properties": {
        "scope": {
          "title": "The clearly defined scope of the test",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment",
            "attack_surface",
            "threat_sources",
            "objectives",
            "level_of_effort",
            "rules_of_engagement"
          ],
          "properties": {
            "environment": {
              "title": "Definition of the environment subject to testing: facilities, users, organizational groups",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "x-enforces": [
                "REQ-SP800-53AR5-0279"
              ]
            },
            "attack_surface": {
              "title": "Definition of the attack surface to be tested",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "x-enforces": [
                "REQ-SP800-53AR5-0280"
              ]
            },
            "threat_sources": {
              "title": "Definition of the threat sources to simulate, as attacker profiles",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "x-enforces": [
                "REQ-SP800-53AR5-0277",
                "REQ-SP800-53AR5-0281"
              ]
            },
            "objectives": {
              "title": "Definition of the objectives for the simulated attacker",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "x-enforces": [
                "REQ-SP800-53AR5-0282"
              ]
            },
            "level_of_effort": {
              "title": "Definition of the level of effort, time and resources, to be expended, considering cost and time available",
              "type": "string",
              "minLength": 1,
              "x-enforces": [
                "REQ-DODI8531.01-0126",
                "REQ-SP800-53AR5-0283"
              ]
            },
            "rules_of_engagement": {
              "title": "Definition of the rules of engagement",
              "type": "string",
              "minLength": 1,
              "x-enforces": [
                "REQ-SP800-53AR5-0274",
                "REQ-SP800-53AR5-0284"
              ]
            }
          },
          "x-enforces": [
            "REQ-SP800-53AR5-0278"
          ]
        },
        "components": {
          "title": "The components subject to penetration testing",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9-]+$"
          },
          "x-enforces": [
            "REQ-SP800-53AR5-0273"
          ]
        },
        "assessor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "party",
            "qualified"
          ],
          "properties": {
            "party": {
              "title": "Who performs the test",
              "enum": [
                "third-party",
                "internal"
              ]
            },
            "qualified": {
              "title": "Whether the assessor is qualified",
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "guidance": {
          "title": "The guidelines the test uses as reference",
          "enum": [
            "NIST SP 800-115",
            "other"
          ]
        },
        "environments": {
          "title": "Environments tested",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "development",
              "operational",
              "test"
            ]
          }
        },
        "option": {
          "title": "Kind of assessment on a cATO path: a Cyber Operations Rapid Assessment, a red or blue team assessment, or another type under an exception to policy",
          "enum": [
            "cora",
            "red-blue-team",
            "other"
          ]
        },
        "exception_to_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved",
            "reference"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "privacy": {
      "title": "Privacy assessment plan of a system processing PII: the privacy controls in scope and their assessors (PASM-001)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessors",
        "controls",
        "sources"
      ],
      "properties": {
        "assessors": {
          "title": "Privacy control assessors: the senior agency official for privacy or an independent assessor on the team",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/persona_id"
          }
        },
        "controls": {
          "title": "Privacy controls of the baseline the privacy assessment plan scopes",
          "type": "array",
          "items": {
            "$ref": "#/$defs/control_id"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "selection": {
      "title": "The assessor selection (Task A-1): the authorizing official or designated representative selects the assessor or assessment team for the type of control assessment to be conducted",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_by",
        "date",
        "assessment_type",
        "expertise"
      ],
      "properties": {
        "selected_by": {
          "$ref": "#/$defs/persona_id"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "assessment_type": {
          "title": "The type of control assessment the assessor was selected for",
          "enum": [
            "security",
            "privacy",
            "security-and-privacy"
          ]
        },
        "expertise": {
          "title": "The technical expertise the selection considered: the skills and technical expertise required to assess the system-specific, hybrid and common controls",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rigor": {
      "title": "What the rigor and scope of the assessment rest on (SP 800-53A 1.1, 2.4, appendix C)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categorization",
        "plans",
        "assurance_requirements",
        "direction"
      ],
      "properties": {
        "categorization": {
          "title": "The security categorization the level of effort rests on",
          "$ref": "#/$defs/source"
        },
        "privacy_risk_assessment": {
          "title": "The privacy risk assessment the level of effort rests on when the system processes PII",
          "$ref": "#/$defs/source"
        },
        "plans": {
          "title": "The approved plans whose controls are assessed",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "assurance_requirements": {
          "title": "The assurance requirements the organization intends to meet",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "requirement",
              "specified_by",
              "depth",
              "coverage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^AR-\\d{3}$"
              },
              "requirement": {
                "title": "The assurance the organization intends to meet",
                "type": "string",
                "minLength": 1
              },
              "specified_by": {
                "title": "The persona of the organization, outside the team, who specified it",
                "$ref": "#/$defs/persona_id"
              },
              "depth": {
                "title": "The least depth attribute value meeting the requirement",
                "enum": [
                  "basic",
                  "focused",
                  "comprehensive"
                ]
              },
              "coverage": {
                "title": "The least coverage attribute value meeting the requirement",
                "enum": [
                  "basic",
                  "focused",
                  "comprehensive"
                ]
              }
            }
          }
        },
        "direction": {
          "title": "The organization's direction on the type, number and specific objects to be assessed",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "conferred_with",
            "factors"
          ],
          "properties": {
            "by": {
              "title": "The persona of the organization, outside the team, who directs",
              "$ref": "#/$defs/persona_id"
            },
            "conferred_with": {
              "title": "The assessors conferred with",
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/persona_id"
              }
            },
            "factors": {
              "title": "The factors considered, such as available resources and the importance of the assessment",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "basis"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "acceptable",
            "not-acceptable"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
