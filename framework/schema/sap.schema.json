{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:sap",
  "title": "runs/<run-id>/artifacts/data/sap.yaml",
  "description": "The agent-written part of the security assessment plan (A-2): scope exclusions, team, schedule, rules of engagement and test events. Reviewed controls and methods are derived from baseline.json and the catalog (plan §7.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "assessment_subjects",
    "team",
    "schedule",
    "rules_of_engagement",
    "sources"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "excluded_controls"
      ],
      "properties": {
        "include": {
          "const": "baseline"
        },
        "excluded_controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control_id",
              "rationale"
            ],
            "properties": {
              "control_id": {
                "$ref": "#/$defs/control_id"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "assessment_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "include"
        ],
        "properties": {
          "type": {
            "enum": [
              "component",
              "inventory-item",
              "location",
              "party",
              "user"
            ]
          },
          "include": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "persona",
          "role"
        ],
        "properties": {
          "persona": {
            "$ref": "#/$defs/persona_id"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "independent": {
            "type": "boolean"
          }
        }
      },
      "minItems": 1
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "description"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "live": {
                  "description": "The event runs on a live network or with live data, so it needs an AD-IATT or authorization in force (AODM-006).",
                  "type": "boolean"
                },
                "kind": {
                "enum": [
                  "kickoff",
                  "dt-e",
                  "ot-e",
                  "scan",
                  "interview",
                  "out-brief",
                  "penetration-test",
                  "other"
                ]
              }
            }
          }
        }
      }
    },
    "rules_of_engagement": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "penetration_test": {
      "title": "The penetration test the plan schedules: its scope at the minimum SP 800-53A Appendix D lists, the assessor, the guidance and, on a cATO path, the environments and the kind of assessment",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "assessor",
        "guidance",
        "components"
      ],
      "properties": {
        "scope": {
          "title": "The clearly defined scope of the test",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment",
            "attack_surface",
            "threat_sources",
            "objectives",
            "level_of_effort",
            "rules_of_engagement"
          ],
          "properties": {
            "environment": {
              "title": "Definition of the environment subject to testing: facilities, users, organizational groups",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "x-enforces": [
                "REQ-SP800-53AR5-0279"
              ]
            },
            "attack_surface": {
              "title": "Definition of the attack surface to be tested",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "x-enforces": [
                "REQ-SP800-53AR5-0280"
              ]
            },
            "threat_sources": {
              "title": "Definition of the threat sources to simulate, as attacker profiles",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "x-enforces": [
                "REQ-SP800-53AR5-0277",
                "REQ-SP800-53AR5-0281"
              ]
            },
            "objectives": {
              "title": "Definition of the objectives for the simulated attacker",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "x-enforces": [
                "REQ-SP800-53AR5-0282"
              ]
            },
            "level_of_effort": {
              "title": "Definition of the level of effort, time and resources, to be expended, considering cost and time available",
              "type": "string",
              "minLength": 1,
              "x-enforces": [
                "REQ-DODI8531.01-0126",
                "REQ-SP800-53AR5-0283"
              ]
            },
            "rules_of_engagement": {
              "title": "Definition of the rules of engagement",
              "type": "string",
              "minLength": 1,
              "x-enforces": [
                "REQ-SP800-53AR5-0274",
                "REQ-SP800-53AR5-0284"
              ]
            }
          },
          "x-enforces": [
            "REQ-SP800-53AR5-0278"
          ]
        },
        "components": {
          "title": "The components subject to penetration testing",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9-]+$"
          },
          "x-enforces": [
            "REQ-SP800-53AR5-0273"
          ]
        },
        "assessor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "party",
            "qualified"
          ],
          "properties": {
            "party": {
              "title": "Who performs the test",
              "enum": [
                "third-party",
                "internal"
              ]
            },
            "qualified": {
              "title": "Whether the assessor is qualified",
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "guidance": {
          "title": "The guidelines the test uses as reference",
          "enum": [
            "NIST SP 800-115",
            "other"
          ]
        },
        "environments": {
          "title": "Environments tested",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "development",
              "operational",
              "test"
            ]
          }
        },
        "option": {
          "title": "Kind of assessment on a cATO path: a Cyber Operations Rapid Assessment, a red or blue team assessment, or another type under an exception to policy",
          "enum": [
            "cora",
            "red-blue-team",
            "other"
          ]
        },
        "exception_to_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved",
            "reference"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
