{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:sap",
  "title": "runs/<run-id>/artifacts/data/sap.yaml",
  "description": "The agent-written part of the security assessment plan (A-2): scope exclusions, team, schedule, rules of engagement and test events. Reviewed controls and methods are derived from baseline.json and the catalog (plan §7.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "assessment_subjects",
    "team",
    "schedule",
    "rules_of_engagement",
    "sources"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "excluded_controls"
      ],
      "properties": {
        "include": {
          "const": "baseline"
        },
        "excluded_controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control_id",
              "rationale"
            ],
            "properties": {
              "control_id": {
                "$ref": "#/$defs/control_id"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "assessment_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "include"
        ],
        "properties": {
          "type": {
            "enum": [
              "component",
              "inventory-item",
              "location",
              "party",
              "user"
            ]
          },
          "include": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "persona",
          "role"
        ],
        "properties": {
          "persona": {
            "$ref": "#/$defs/persona_id"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "independent": {
            "type": "boolean"
          }
        }
      },
      "minItems": 1
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "description"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "live": {
                  "description": "The event runs on a live network or with live data, so it needs an AD-IATT or authorization in force (AODM-006).",
                  "type": "boolean"
                },
                "kind": {
                "enum": [
                  "kickoff",
                  "dt-e",
                  "ot-e",
                  "scan",
                  "interview",
                  "out-brief",
                  "other"
                ]
              }
            }
          }
        }
      }
    },
    "rules_of_engagement": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
