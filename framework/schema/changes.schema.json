{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:changes",
  "title": "runs/<run-id>/artifacts/data/changes.yaml",
  "description": "The change log behind ART-CHG (M-1): each change, its security impact and its path through change control, the monitoring for unauthorized changes, and the AO decisions enforced on hosted and interconnected systems. MCHG-001 to MCHG-003 and MCON-001 judge it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "monitoring",
    "changes",
    "sources"
  ],
  "properties": {
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unauthorized_changes"
      ],
      "properties": {
        "unauthorized_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "method",
            "reconciled_against"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/date",
              "title": "Start of monitoring for unauthorized changes, no later than the first authorization"
            },
            "to": {
              "$ref": "#/$defs/date",
              "title": "End of the monitoring period"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "reconciled_against": {
              "title": "What monitored changes are reconciled with",
              "type": "array",
              "items": {
                "enum": [
                  "baseline",
                  "inventory",
                  "change-requests"
                ]
              }
            }
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "origin",
          "date",
          "summary",
          "requested_by",
          "control",
          "security_impact",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CHG-\\d{3}$"
          },
          "origin": {
            "title": "How the change reached the change log: requested, unscheduled emergency, unauthorized change found by monitoring, an LE/CI deployment or a DoW order",
            "enum": [
              "requested",
              "unscheduled",
              "unauthorized",
              "le-ci",
              "dow-order"
            ]
          },
          "date": {
            "$ref": "#/$defs/date",
            "title": "Date of the change request, or the date an unauthorized change was detected"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "requested_by": {
            "$ref": "#/$defs/persona_id",
            "title": "Requester of the change, or the role that detected it"
          },
          "control": {
            "title": "Whether the proposed change requires configuration control, or is noted as exempt or pre-approved on the change request",
            "enum": [
              "required",
              "exempt",
              "pre-approved"
            ],
            "x-enforces": [
              "REQ-SP800-128-0210"
            ]
          },
          "security_impact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "analysis"
            ],
            "properties": {
              "result": {
                "title": "Security impact analysis result of the change, including unscheduled and unauthorized changes",
                "enum": [
                  "none",
                  "limited",
                  "significant"
                ],
                "x-enforces": [
                  "REQ-SP800-128-0210",
                  "REQ-SP800-128-0217"
                ]
              },
              "analysis": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "privacy_impact": {
            "title": "The change impacts the privacy posture of the system",
            "type": "boolean"
          },
          "external_service": {
            "title": "Leveraged external IT service whose status the change alters, or null for none; required once the system leverages an external service",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^LA-\\d{2,3}$"
          },
          "test": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "title": "Result of testing the proposed change for security and functional impacts",
                "enum": [
                  "pass",
                  "fail",
                  "not-run"
                ]
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "presented_to": {
                "title": "Those the impacts of the change are presented to",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/persona_id"
                }
              }
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "outcome",
              "date",
              "communicated_to"
            ],
            "properties": {
              "by": {
                "$ref": "#/$defs/persona_id",
                "title": "Board that decided the change"
              },
              "outcome": {
                "title": "The board decision",
                "enum": [
                  "approved",
                  "disapproved",
                  "deferred"
                ]
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "communicated_to": {
                "title": "Those each CCB decision is communicated to, the requester among them",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/persona_id"
                },
                "minItems": 1
              }
            }
          },
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "notified"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "notified": {
                "title": "Stakeholders notified about the change",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "x-enforces": [
                  "REQ-SP800-128-0213"
                ]
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "date",
              "result"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "result": {
                "title": "Whether the change was verified as implemented correctly and deployed without issues",
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          },
          "closed": {
            "$ref": "#/$defs/date",
            "title": "Date the change request was closed out"
          },
          "root_cause": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cause",
              "determined"
            ],
            "properties": {
              "cause": {
                "title": "Root cause of the unauthorized change, or under-analysis while the analysis runs",
                "enum": [
                  "adversary-attack",
                  "process-failure",
                  "inadvertent-error",
                  "other",
                  "under-analysis"
                ]
              },
              "determined": {
                "$ref": "#/$defs/date"
              },
              "response": {
                "title": "POA&M item or risk that responds to the root cause (Task M-3)",
                "type": "string",
                "pattern": "^(POAM|RSK)-\\d{3}$"
              }
            }
          },
          "le_ci": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lawful",
              "basis",
              "coordinated_with",
              "attempted",
              "outcome"
            ],
            "properties": {
              "lawful": {
                "title": "The LE/CI deployment is legitimate and lawful",
                "type": "boolean"
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "coordinated_with": {
                "$ref": "#/$defs/persona_id",
                "title": "Authorizing official the LE/CI organization coordinates the implementation with"
              },
              "attempted": {
                "$ref": "#/$defs/date",
                "title": "Date of the attempt to coordinate the implementation with the AO"
              },
              "outcome": {
                "title": "Whether the reasonable attempt reached the AO",
                "enum": [
                  "coordinated",
                  "attempted"
                ]
              }
            }
          },
          "sources": {
            "$ref": "#/$defs/sources"
          }
        }
      }
    },
    "connections": {
      "title": "Hosted or interconnected systems and the AO decision enforced on each",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "system",
          "relationship",
          "decision",
          "action",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CON-\\d{3}$"
          },
          "system": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "title": "Boundary component of type interconnection",
            "type": "string",
            "pattern": "^CMP-[A-Z0-9-]+$"
          },
          "relationship": {
            "title": "How the system relates to this one",
            "enum": [
              "hosted",
              "interconnected"
            ]
          },
          "decision": {
            "title": "AO authorization decision on the system",
            "type": "string",
            "pattern": "^AD-[A-Z]{2,6}$"
          },
          "authorization_termination_date": {
            "$ref": "#/$defs/date"
          },
          "action": {
            "title": "What the PM does to enforce the AO authorization decision",
            "enum": [
              "connected",
              "restricted",
              "disconnected"
            ]
          },
          "sources": {
            "$ref": "#/$defs/sources"
          }
        }
      }
    },
    "sources": {
      "$ref": "#/$defs/sources"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  }
}
