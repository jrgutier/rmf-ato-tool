{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:boundary",
  "title": "runs/<run-id>/artifacts/data/boundary.yaml",
  "description": "Authorization boundary, network architecture, data flow and components (P-11; updated by P-16, C-1). The boundary ID itself lives in facts.yaml (INV-4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_boundary",
    "network_architecture",
    "data_flow",
    "components"
  ],
  "properties": {
    "authorization_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "sources"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "caption"
            ],
            "properties": {
              "path": {
                "description": "Relative to the run directory; a product/ path resolves under the run's product directory, as a trace token does.",
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "shows": {
                "title": "What the diagram depicts, from the content SP 800-18r2 lists for system, network architecture and data flow diagrams",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "components",
                    "subsystems",
                    "internal-boundaries",
                    "data-stores",
                    "virtual-components",
                    "third-party-services",
                    "external-connections",
                    "routing-controls",
                    "physical-protections",
                    "isolated-components",
                    "data-types",
                    "data-direction",
                    "external-flows",
                    "physical-locations",
                    "logical-locations"
                  ]
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "network_architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "sources"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "caption"
            ],
            "properties": {
              "path": {
                "description": "Relative to the run directory; a product/ path resolves under the run's product directory, as a trace token does.",
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "shows": {
                "title": "What the diagram depicts, from the content SP 800-18r2 lists for system, network architecture and data flow diagrams",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "components",
                    "subsystems",
                    "internal-boundaries",
                    "data-stores",
                    "virtual-components",
                    "third-party-services",
                    "external-connections",
                    "routing-controls",
                    "physical-protections",
                    "isolated-components",
                    "data-types",
                    "data-direction",
                    "external-flows",
                    "physical-locations",
                    "logical-locations"
                  ]
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "data_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "sources"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "caption"
            ],
            "properties": {
              "path": {
                "description": "Relative to the run directory; a product/ path resolves under the run's product directory, as a trace token does.",
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "shows": {
                "title": "What the diagram depicts, from the content SP 800-18r2 lists for system, network architecture and data flow diagrams",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "components",
                    "subsystems",
                    "internal-boundaries",
                    "data-stores",
                    "virtual-components",
                    "third-party-services",
                    "external-connections",
                    "routing-controls",
                    "physical-protections",
                    "isolated-components",
                    "data-types",
                    "data-direction",
                    "external-flows",
                    "physical-locations",
                    "logical-locations"
                  ]
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "type",
          "description",
          "status",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "description": "OSCAL component types.",
            "enum": [
              "this-system",
              "system",
              "interconnection",
              "software",
              "hardware",
              "service",
              "policy",
              "physical",
              "process-procedure",
              "plan",
              "guidance",
              "standard",
              "validation"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "operational",
              "under-development",
              "under-major-modification",
              "disposition",
              "other"
            ]
          },
          "external": {
            "description": "Outside the boundary (interconnections, leveraged services).",
            "type": "boolean"
          },
          "leveraged_authorization": {
            "type": "string",
            "pattern": "^LA-\\d{2,3}$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      },
      "minItems": 1
    },
    "subsystems": {
      "title": "The subsystems of a complex system, each with its components, categorization and operational status (P-11, C-2)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "components",
          "c",
          "i",
          "a",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SUB-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^CMP-[A-Z0-9-]+$"
            }
          },
          "c": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "i": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "a": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "status": {
            "title": "Operational status of the subsystem within the authorization boundary",
            "enum": [
              "operational",
              "under-development",
              "under-major-modification",
              "disposition",
              "other"
            ],
            "x-enforces": [
              "REQ-SP800-18R2-0247"
            ]
          },
          "readiness": {
            "title": "Readiness of the subsystem within the environment of operation",
            "type": "string",
            "minLength": 1,
            "x-enforces": [
              "REQ-SP800-18R2-0432"
            ]
          }
        }
      }
    },
    "subsystem_interfaces": {
      "title": "The interfaces between subsystems: information flows, dependencies, and the controls selected for the interconnection where categorizations differ",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "between",
          "connected",
          "flows"
        ],
        "properties": {
          "between": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^SUB-[A-Z0-9-]+$"
            }
          },
          "connected": {
            "title": "Whether the subsystems exchange information",
            "type": "boolean"
          },
          "flows": {
            "title": "Information flows and security and privacy dependencies across the interface",
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "title": "Controls selected for the interconnection of the subsystems",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}-\\d+(\\.\\d+)?$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
