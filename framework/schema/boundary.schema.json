{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:boundary",
  "title": "runs/<run-id>/artifacts/data/boundary.yaml",
  "description": "Authorization boundary, network architecture, data flow and components (P-11; updated by P-16, C-1). The boundary ID itself lives in facts.yaml (INV-4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_boundary",
    "network_architecture",
    "data_flow",
    "components"
  ],
  "properties": {
    "authorization_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "sources"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "caption"
            ],
            "properties": {
              "path": {
                "description": "Relative to the run directory.",
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "network_architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "sources"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "caption"
            ],
            "properties": {
              "path": {
                "description": "Relative to the run directory.",
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "data_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "sources"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "caption"
            ],
            "properties": {
              "path": {
                "description": "Relative to the run directory.",
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "type",
          "description",
          "status",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "description": "OSCAL component types.",
            "enum": [
              "this-system",
              "system",
              "interconnection",
              "software",
              "hardware",
              "service",
              "policy",
              "physical",
              "process-procedure",
              "plan",
              "guidance",
              "standard",
              "validation"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "operational",
              "under-development",
              "under-major-modification",
              "disposition",
              "other"
            ]
          },
          "external": {
            "description": "Outside the boundary (interconnections, leveraged services).",
            "type": "boolean"
          },
          "leveraged_authorization": {
            "type": "string",
            "pattern": "^LA-\\d{2,3}$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
