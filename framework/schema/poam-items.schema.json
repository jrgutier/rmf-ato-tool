{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:poam-items",
  "title": "runs/<run-id>/artifacts/poam/items.yaml",
  "description": "POA&M items (A-6; updated by R-3, M-3). DoD-required fields (severity, point of contact, resources, scheduled completion, milestones) are POAM-FLD-001, so a partial item fails that rule rather than the schema. MPOA-001 judges the recommendation, the AO review and the outside findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "finding_ref",
          "control_id",
          "weakness",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^POAM-\\d{3}$"
          },
          "finding_ref": {
            "description": "A SAR finding (FND-###), a STIG finding (STG-###), an outside finding (EXF-###), a directed action (DIR-###), a VDP report (VDP-###) or an analyzed vulnerability (VUL-###).",
            "type": "string",
            "pattern": "^(FND|STG|EXF|DIR|VDP|VUL)-\\d{3}$"
          },
          "control_id": {
            "$ref": "#/$defs/control_id"
          },
          "weakness": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_of_weakness": {
            "enum": [
              "sar",
              "stig",
              "conmon",
              "inspection",
              "audit",
              "directed-action",
              "vdp",
              "other"
            ]
          },
          "severity": {
            "$ref": "#/$defs/level"
          },
          "residual_risk": {
            "$ref": "#/$defs/level"
          },
          "status": {
            "title": "Vulnerability status: Completed, Ongoing, Delayed or Planned, or risk-accepted once the AO accepts the risk (open is the older contract's word)",
            "enum": [
              "open",
              "planned",
              "ongoing",
              "delayed",
              "completed",
              "risk-accepted"
            ]
          },
          "point_of_contact": {
            "$ref": "#/$defs/persona_id"
          },
          "resources_required": {
            "type": "string",
            "minLength": 1
          },
          "scheduled_completion": {
            "$ref": "#/$defs/date"
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "due"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "due": {
                  "$ref": "#/$defs/date"
                },
                "completed": {
                  "title": "When the milestone was met",
                  "$ref": "#/$defs/date"
                }
              }
            }
          },
          "comments": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "recommended_completion": {
            "title": "Recommendation for completion of the task before or after system authorization",
            "enum": [
              "before-authorization",
              "after-authorization"
            ]
          },
          "risk_level": {
            "title": "Risk assessment level from the RAR",
            "$ref": "#/$defs/level"
          },
          "criticality": {
            "title": "Criticality of the identified control deficiency",
            "$ref": "#/$defs/level"
          },
          "mitigation_approach": {
            "title": "The proposed risk mitigation approach",
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "title": "Rank of this item in the prioritized approach to risk mitigation; 1 goes first",
            "type": "integer",
            "minimum": 1
          },
          "identified": {
            "title": "The event that identified the weakness",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "reviewing_organization",
              "date"
            ],
            "properties": {
              "event": {
                "title": "Event that identified the weakness",
                "enum": [
                  "security-control-assessment",
                  "penetration-test",
                  "stig-scan",
                  "continuous-monitoring",
                  "audit",
                  "other"
                ]
              },
              "reviewing_organization": {
                "title": "Reviewing organization",
                "type": "string",
                "minLength": 1
              },
              "date": {
                "title": "Date the weakness was identified",
                "$ref": "#/$defs/date"
              }
            }
          },
          "completed_on": {
            "title": "Actual completion date",
            "$ref": "#/$defs/date"
          },
          "corrective_action_test": {
            "title": "The test of the corrective action",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "date",
              "result"
            ],
            "properties": {
              "by": {
                "title": "Who tested the corrective action",
                "$ref": "#/$defs/persona_id"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "obstacles": {
            "title": "Obstacles and challenges not related to funding",
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "personnel",
                "expertise",
                "legacy-replacement",
                "dependency",
                "schedule",
                "technical",
                "other"
              ]
            }
          },
          "milestone_changes": {
            "title": "Changes to milestones; original dates stay as they are",
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "milestone",
                "new_date",
                "reason"
              ],
              "properties": {
                "milestone": {
                  "title": "The original milestone, by its description",
                  "type": "string",
                  "minLength": 1
                },
                "new_date": {
                  "title": "New estimated date of the milestone's completion",
                  "$ref": "#/$defs/date"
                },
                "reason": {
                  "title": "Reason for the change in milestone completion",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "ao_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "reviewed",
        "agreed"
      ],
      "properties": {
        "by": {
          "$ref": "#/$defs/persona_id",
          "title": "Authorizing official who reviews the plan of action and milestones"
        },
        "reviewed": {
          "$ref": "#/$defs/date"
        },
        "agreed": {
          "title": "Agreement with the remediation actions planned",
          "const": true,
          "x-enforces": [
            "REQ-SP800-37R2-0377"
          ]
        }
      }
    },
    "external_findings": {
      "title": "Findings of readiness inspections and outside evaluations, a named POA&M source (M-3)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "body",
          "event",
          "date",
          "summary",
          "verified",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EXF-\\d{3}$"
          },
          "body": {
            "title": "Who made the finding",
            "enum": [
              "DoD-Component",
              "CDRUSSTRATCOM",
              "DISA",
              "DIRNSA",
              "DIA",
              "Inspector-General",
              "other"
            ]
          },
          "event": {
            "title": "What found it",
            "enum": [
              "readiness-inspection",
              "joint-compliance-inspection",
              "evaluation",
              "penetration-assessment",
              "red-team",
              "audit"
            ],
            "x-enforces": [
              "REQ-DOWI8430.01-0077"
            ]
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "poam_item": {
            "title": "POA&M item that carries the finding",
            "type": "string",
            "pattern": "^POAM-\\d{3}$"
          },
          "accepted_in": {
            "title": "Ledger record that accepts the deficiency as residual risk",
            "type": "string",
            "pattern": "^AUTH-\\d{3}$"
          },
          "verified": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "date"
            ],
            "properties": {
              "by": {
                "$ref": "#/$defs/persona_id"
              },
              "date": {
                "$ref": "#/$defs/date"
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "directed_actions": {
      "title": "Orders and directives the system received and its response (M-3, EXT-DIRECTIVES)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "reference",
          "issued_by",
          "received_through",
          "received",
          "action",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DIR-\\d{3}$"
          },
          "kind": {
            "title": "Kind of order or directive: an operation, fragmentary, tasking or execute order, an IAVM vulnerability management alert or bulletin, or a CPCON change",
            "enum": [
              "opord",
              "fragord",
              "taskord",
              "exord",
              "vm-alert",
              "vm-bulletin",
              "cpcon"
            ]
          },
          "reference": {
            "title": "Number of the order, alert or bulletin",
            "type": "string",
            "minLength": 1
          },
          "issued_by": {
            "title": "Authority that issued the directed action",
            "enum": [
              "CDRUSSTRATCOM",
              "CDRUSCYBERCOM",
              "JFHQ-DODIN",
              "DoD-Component"
            ]
          },
          "received_through": {
            "title": "Channel through which the system received the order",
            "enum": [
              "NOSC",
              "CSSP",
              "Component-headquarters"
            ]
          },
          "received": {
            "$ref": "#/$defs/date"
          },
          "action": {
            "title": "What the order directs the system to do",
            "type": "string",
            "minLength": 1
          },
          "implementers": {
            "title": "Who implements the directed action: a persona, or a role DoDI 8530.01 names that has none",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/persona_id"
                },
                {
                  "enum": [
                    "commander",
                    "supervisor",
                    "project-lead",
                    "network-administrator",
                    "system-administrator",
                    "user"
                  ]
                }
              ]
            }
          },
          "response": {
            "title": "Implemented, tracked in a POA&M item, withheld after coordination, or not applicable to the system",
            "enum": [
              "implemented",
              "poam",
              "withheld",
              "not-applicable"
            ]
          },
          "not_applicable_reason": {
            "title": "Why the order does not apply to the system",
            "type": "string",
            "minLength": 1
          },
          "implemented": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "change": {
                "title": "Change log record that made a patch or configuration change",
                "type": "string",
                "pattern": "^CHG-\\d{3}$"
              }
            }
          },
          "poam_item": {
            "title": "POA&M item that carries it",
            "type": "string",
            "pattern": "^POAM-\\d{3}$"
          },
          "withheld": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "coordinated_with",
              "reason"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "coordinated_with": {
                "type": "array",
                "items": {
                  "enum": [
                    "PER-SPONSOR",
                    "PER-AO",
                    "PER-AODR",
                    "Component-cyberspace-forces"
                  ]
                },
                "minItems": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "compliance_reports": {
            "title": "Compliance status reported to the chain",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "to",
                "through",
                "status"
              ],
              "properties": {
                "date": {
                  "$ref": "#/$defs/date"
                },
                "to": {
                  "enum": [
                    "CDRUSCYBERCOM",
                    "JFHQ-DODIN"
                  ]
                },
                "through": {
                  "enum": [
                    "Component-reporting-chain",
                    "Component-headquarters",
                    "CSSP"
                  ]
                },
                "status": {
                  "enum": [
                    "compliant",
                    "poam",
                    "withheld",
                    "not-applicable"
                  ]
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "vdp_reports": {
      "title": "Vulnerability disclosure reports that reached the system (M-3, EXT-VDP)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "received",
          "received_from",
          "summary",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VDP-\\d{3}$"
          },
          "received": {
            "$ref": "#/$defs/date"
          },
          "received_from": {
            "title": "Who delivered the vulnerability disclosure report",
            "enum": [
              "DC3",
              "JFHQ-DODIN",
              "USCYBERCOM"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "title": "Validation of the reported vulnerability",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "date",
              "result"
            ],
            "properties": {
              "by": {
                "$ref": "#/$defs/persona_id"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "result": {
                "enum": [
                  "valid",
                  "not-valid"
                ]
              }
            }
          },
          "vulnerability": {
            "title": "Vulnerability analysis record that rates its severity",
            "type": "string",
            "pattern": "^VUL-\\d{3}$"
          },
          "poam_item": {
            "title": "POA&M item that carries it",
            "type": "string",
            "pattern": "^POAM-\\d{3}$"
          },
          "owner_informed": {
            "title": "When the system owner was told of actions and completion",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "about"
              ],
              "properties": {
                "date": {
                  "$ref": "#/$defs/date"
                },
                "about": {
                  "enum": [
                    "progress",
                    "completion"
                  ]
                }
              }
            }
          },
          "ao_advised": {
            "title": "When the authorizing official was advised of the actions",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "to",
              "date"
            ],
            "properties": {
              "to": {
                "$ref": "#/$defs/persona_id"
              },
              "date": {
                "$ref": "#/$defs/date"
              }
            }
          },
          "vrmn_reports": {
            "title": "Reports through the chain of command to DC3 and USCYBERCOM within VRMN",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "status"
              ],
              "properties": {
                "date": {
                  "$ref": "#/$defs/date"
                },
                "status": {
                  "enum": [
                    "open",
                    "remediated",
                    "mitigated",
                    "not-valid"
                  ]
                }
              }
            }
          },
          "details_requested": {
            "title": "Requests to DC3 for more information, through the chain of command",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "through"
              ],
              "properties": {
                "date": {
                  "$ref": "#/$defs/date"
                },
                "through": {
                  "enum": [
                    "USCYBERCOM",
                    "Component-CIO"
                  ]
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "vulnerabilities": {
      "title": "Vulnerability analysis records: the analysis report per vulnerability (M-2, M-3)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "discovered",
          "cvss",
          "publicly_known",
          "newly_discovered",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VUL-\\d{3}$"
          },
          "name": {
            "title": "Name of the vulnerability",
            "type": "string",
            "minLength": 1
          },
          "cve": {
            "type": "string",
            "pattern": "^CVE-\\d{4}-\\d{4,}$"
          },
          "advisory": {
            "title": "Public advisory or bulletin naming it",
            "type": "string",
            "minLength": 1
          },
          "discovered": {
            "$ref": "#/$defs/date"
          },
          "reported": {
            "title": "When and to whom the vulnerability was reported",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "to"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "cvss": {
            "title": "CVSS 3.1 score and qualitative severity rating",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "score",
              "rating"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "rating": {
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            }
          },
          "impact": {
            "title": "Expected loss of confidentiality, integrity and availability if not remediated",
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "confidentiality": {
                "enum": [
                  "none",
                  "limited",
                  "serious",
                  "catastrophic",
                  "cataclysmic"
                ]
              },
              "integrity": {
                "enum": [
                  "none",
                  "limited",
                  "serious",
                  "catastrophic",
                  "cataclysmic"
                ]
              },
              "availability": {
                "enum": [
                  "none",
                  "limited",
                  "serious",
                  "catastrophic",
                  "cataclysmic"
                ]
              }
            }
          },
          "recommendation": {
            "title": "Recommendation to correct the vulnerability",
            "type": "string",
            "minLength": 1
          },
          "publicly_known": {
            "type": "boolean"
          },
          "newly_discovered": {
            "type": "boolean"
          },
          "vep_submission": {
            "title": "Submission toward the Vulnerabilities Equities Process",
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "to": {
                "enum": [
                  "USCYBERCOM",
                  "NSA-direct"
                ]
              },
              "prior": {
                "type": "boolean"
              },
              "reference": {
                "title": "The earlier submission",
                "type": "string",
                "minLength": 1
              }
            }
          },
          "remediation": {
            "title": "Method chosen case by case, and the options and factors weighed",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "options",
              "considers",
              "poam_item"
            ],
            "properties": {
              "method": {
                "enum": [
                  "remediation",
                  "mitigation"
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "method",
                    "description"
                  ],
                  "properties": {
                    "method": {
                      "enum": [
                        "remediation",
                        "mitigation"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "considers": {
                "type": "array",
                "items": {
                  "enum": [
                    "confidentiality",
                    "integrity",
                    "availability"
                  ]
                }
              },
              "factors": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "asset_value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "exposure_factor": {
                    "type": "number",
                    "minimum": 0
                  },
                  "single_loss_expectancy": {
                    "type": "number",
                    "minimum": 0
                  },
                  "annual_rate_of_occurrence": {
                    "type": "number",
                    "minimum": 0
                  },
                  "annualized_loss_expectancy": {
                    "type": "number",
                    "minimum": 0
                  },
                  "total_cost_of_ownership": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "poam_item": {
                "title": "POA&M item that carries it",
                "type": "string",
                "pattern": "^POAM-\\d{3}$"
              }
            }
          },
          "verification": {
            "title": "Verification of the fix on completion",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "scans"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "scans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date",
                    "result"
                  ],
                  "properties": {
                    "date": {
                      "$ref": "#/$defs/date"
                    },
                    "result": {
                      "enum": [
                        "present",
                        "absent"
                      ]
                    }
                  }
                }
              },
              "baseline_restored": {
                "type": "boolean"
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "level": {
      "description": "SP 800-30 qualitative scale.",
      "enum": [
        "very-low",
        "low",
        "moderate",
        "high",
        "very-high"
      ]
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
