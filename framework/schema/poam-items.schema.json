{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:poam-items",
  "title": "runs/<run-id>/artifacts/poam/items.yaml",
  "description": "POA&M items (A-6; updated by R-3, M-3). DoD-required fields (severity, point of contact, resources, scheduled completion, milestones) are POAM-FLD-001, so a partial item fails that rule rather than the schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "finding_ref",
          "control_id",
          "weakness",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^POAM-\\d{3}$"
          },
          "finding_ref": {
            "description": "A SAR finding (FND-###) or STIG finding (STG-###).",
            "type": "string",
            "pattern": "^(FND|STG)-\\d{3}$"
          },
          "control_id": {
            "$ref": "#/$defs/control_id"
          },
          "weakness": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_of_weakness": {
            "enum": [
              "sar",
              "stig",
              "conmon",
              "other"
            ]
          },
          "severity": {
            "$ref": "#/$defs/level"
          },
          "residual_risk": {
            "$ref": "#/$defs/level"
          },
          "status": {
            "title": "Vulnerability status: Completed, Ongoing, Delayed or Planned, or risk-accepted once the AO accepts the risk (open is the older contract's word)",
            "enum": [
              "open",
              "planned",
              "ongoing",
              "delayed",
              "completed",
              "risk-accepted"
            ]
          },
          "point_of_contact": {
            "$ref": "#/$defs/persona_id"
          },
          "resources_required": {
            "type": "string",
            "minLength": 1
          },
          "scheduled_completion": {
            "$ref": "#/$defs/date"
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "due"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "due": {
                  "$ref": "#/$defs/date"
                },
                "completed": {
                  "title": "When the milestone was met",
                  "$ref": "#/$defs/date"
                }
              }
            }
          },
          "comments": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "risk_level": {
            "title": "Risk assessment level from the RAR",
            "$ref": "#/$defs/level"
          },
          "criticality": {
            "title": "Criticality of the identified control deficiency",
            "$ref": "#/$defs/level"
          },
          "mitigation_approach": {
            "title": "The proposed risk mitigation approach",
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "title": "Rank of this item in the prioritized approach to risk mitigation; 1 goes first",
            "type": "integer",
            "minimum": 1
          },
          "identified": {
            "title": "The event that identified the weakness",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "reviewing_organization",
              "date"
            ],
            "properties": {
              "event": {
                "title": "Event that identified the weakness",
                "enum": [
                  "security-control-assessment",
                  "penetration-test",
                  "stig-scan",
                  "continuous-monitoring",
                  "audit",
                  "other"
                ]
              },
              "reviewing_organization": {
                "title": "Reviewing organization",
                "type": "string",
                "minLength": 1
              },
              "date": {
                "title": "Date the weakness was identified",
                "$ref": "#/$defs/date"
              }
            }
          },
          "completed_on": {
            "title": "Actual completion date",
            "$ref": "#/$defs/date"
          },
          "corrective_action_test": {
            "title": "The test of the corrective action",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "date",
              "result"
            ],
            "properties": {
              "by": {
                "title": "Who tested the corrective action",
                "$ref": "#/$defs/persona_id"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "obstacles": {
            "title": "Obstacles and challenges not related to funding",
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "personnel",
                "expertise",
                "legacy-replacement",
                "dependency",
                "schedule",
                "technical",
                "other"
              ]
            }
          },
          "milestone_changes": {
            "title": "Changes to milestones; original dates stay as they are",
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "milestone",
                "new_date",
                "reason"
              ],
              "properties": {
                "milestone": {
                  "title": "The original milestone, by its description",
                  "type": "string",
                  "minLength": 1
                },
                "new_date": {
                  "title": "New estimated date of the milestone's completion",
                  "$ref": "#/$defs/date"
                },
                "reason": {
                  "title": "Reason for the change in milestone completion",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "level": {
      "description": "SP 800-30 qualitative scale.",
      "enum": [
        "very-low",
        "low",
        "moderate",
        "high",
        "very-high"
      ]
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
