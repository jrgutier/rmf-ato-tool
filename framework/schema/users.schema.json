{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:users",
  "title": "runs/<run-id>/artifacts/data/users.yaml",
  "description": "System users and privileges (C-1); OSCAL SSP system-implementation.users.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "users"
  ],
  "properties": {
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "type",
          "privilege_level",
          "authorized_privileges",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^USR-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "internal",
              "external",
              "general-public"
            ]
          },
          "privilege_level": {
            "enum": [
              "privileged",
              "non-privileged",
              "no-logical-access"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authorized_privileges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "functions_performed"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "functions_performed": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
