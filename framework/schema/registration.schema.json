{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:registration",
  "title": "runs/<run-id>/artifacts/data/registration.yaml",
  "description": "Registration data behind ART-REG (P-18): the Component registry entry, and the system's registration of its ports, protocols and services in the DoD PPSM Registry. UPD-001, PPSM-001 and RCP-008 judge it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources"
  ],
  "properties": {
    "registry": {
      "title": "The DoD Component registry entry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "date",
        "record",
        "reported_in",
        "tool"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reported_in": {
          "title": "Where the system is reported: eMASS or ERS",
          "x-enforces": ["REQ-DODI8500.01-0172", "REQ-DODI8500.01-0301"],
          "enum": ["eMASS", "ERS"]
        },
        "tool": {
          "title": "The Component's tool for system data: eMASS, ERS, or an alternate tool",
          "enum": ["eMASS", "ERS", "alternate"]
        },
        "ers_import": {
          "title": "How the system data of an alternate tool is regularly imported into ERS, as worked out with the DoD CIO",
          "type": ["string", "null"]
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "deployment_locations": {
          "title": "Deployment locations of the system, kept in the authorization tracking tool",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "updates": {
          "title": "Updates of the tracking tool after this organization accepts a system it receives",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "received_system"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "received_system": {
                "type": "string",
                "pattern": "^RS-\\d{2}$"
              }
            }
          }
        },
        "reciprocity": {
          "title": "Listing of the system as a reciprocity system in the registry",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "listed"
          ],
          "properties": {
            "listed": {
              "type": "boolean"
            },
            "exemption_justification": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "updates": {
      "title": "Updates of the registration information after registration, each by the task that makes it (UPD-001)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "content", "date"],
        "properties": {
          "task": {"enum": ["C-1", "C-3", "R-5", "M-7"]},
          "content": {
            "title": "What the update adds: the characterization (C-1), the categorization (C-3), the authorization decision (R-5) or the removal from service (M-7)",
            "enum": ["characterization", "categorization", "authorization", "disposal"]
          },
          "date": {"$ref": "#/$defs/date"},
          "notes": {"type": "string"}
        }
      }
    },
    "ppsm": {
      "title": "Registration of ports, protocols and services in the DoD PPSM Registry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered",
        "registry_id",
        "connections"
      ],
      "properties": {
        "registered": {
          "$ref": "#/$defs/date"
        },
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "connections": {
          "title": "Boundary connections whose ports, protocols and services are registered",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CONN-\\d{2,3}$"
          },
          "uniqueItems": true
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
