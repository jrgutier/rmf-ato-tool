{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:sar-results",
  "title": "runs/<run-id>/artifacts/sar/results/<fam>[.<n>].yaml",
  "description": "Assessment determinations and findings for one family (A-3; updated by A-4, A-5). Coverage is SAR-COV-001; open findings need a POA&M item (SAR-POAM-001).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family",
    "determinations",
    "findings"
  ],
  "properties": {
    "family": {
      "$ref": "#/$defs/family"
    },
    "chunk": {
      "type": "integer",
      "minimum": 1
    },
    "additional_results": {
      "title": "Results of the plan's additional procedures (APR-###) whose requirement sits with this family's controls; every APR has one once sar-summary.yaml is written (ASMT-005)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apr_id",
          "statements",
          "sources"
        ],
        "properties": {
          "apr_id": {
            "type": "string",
            "pattern": "^APR-\\d{3}$"
          },
          "statements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "result"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "enum": [
                    "satisfied",
                    "other-than-satisfied",
                    "not-evaluated"
                  ]
                }
              }
            }
          },
          "finding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FND-\\d{3}$"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "determinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "result",
          "methods",
          "summary",
          "sources"
        ],
        "properties": {
          "control_id": {
            "$ref": "#/$defs/control_id",
            "title": "Security or privacy control or control enhancement designator, from the catalog",
            "x-enforces": [
              "REQ-SP800-53AR5-0297"
            ]
          },
          "result": {
            "title": "Security control compliance status: satisfied, other than satisfied or not evaluated; not-applicable maps to not evaluated (CNSSI 1254)",
            "enum": [
              "satisfied",
              "other-than-satisfied",
              "not-evaluated",
              "not-applicable"
            ],
            "x-enforces": [
              "REQ-CNSSI1254-0068",
              "REQ-SP800-53AR5-0300",
              "REQ-SP800-53AR5-0225"
            ]
          },
          "methods": {
            "type": "array",
            "items": {
              "enum": [
                "examine",
                "interview",
                "test"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "finding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FND-\\d{3}$"
            },
            "uniqueItems": true
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "statements": {
            "title": "The finding of each determination statement of the control",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "result"
              ],
              "properties": {
                "id": {
                  "title": "Determination statement label from the catalog (AC-02a.[01])",
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "title": "Finding of the determination statement",
                  "enum": [
                    "satisfied",
                    "other-than-satisfied",
                    "not-evaluated",
                    "not-applicable",
                    "not-yet-occurred"
                  ],
                  "description": "not-yet-occurred: the event the statement concerns has not happened yet (no exercise, no incident), a timing state, with a reason; it does not count against a satisfied control"
                },
                "reason": {
                  "title": "Why the determination statement does not apply, or what has not yet occurred",
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "title": "What the result rests on: product (a result the product states), simulated (a simulated test of a mechanism the product describes, with nothing contrary), assumption (no evidence; name it), provider-assessment (a provider's part of a hybrid control, judged on its package; name the provider)",
                  "enum": [
                    "product",
                    "simulated",
                    "assumption",
                    "provider-assessment"
                  ]
                },
                "provider": {
                  "title": "For basis provider-assessment: the EXT-### of sap.yaml external_providers whose package shows the statement met",
                  "type": "string",
                  "pattern": "^EXT-\\d{3}$"
                },
                "assumption": {
                  "title": "The ASM-### the result rests on when no evidence could show it, so the SAR shows which determinations rest on an assumption",
                  "type": "string",
                  "pattern": "^ASM-(?:[A-Z]+-)?\\d{3}$"
                }
              }
            }
          },
          "reused": {
            "title": "Reused assessment results this determination rests on",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RR-\\d{3}$"
            },
            "uniqueItems": true
          },
          "inherited": {
            "title": "For an inherited control: the common control provider's assessment the determination rests on, and the assessor's check that the system inherits and uses the control",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis",
              "verified",
              "provider_assessment"
            ],
            "properties": {
              "basis": {
                "enum": [
                  "provider-assessment"
                ]
              },
              "provider_assessment": {
                "title": "The provider's assessment results the determination rests on, and when they were made available to the system owner",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference",
                  "available_on"
                ],
                "properties": {
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "available_on": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              },
              "verified": {
                "title": "Whether the assessor verified the system inherits and uses the control and does not implement it itself",
                "type": "boolean"
              }
            }
          },
          "depth": {
            "title": "Depth attribute value the assessors applied",
            "enum": [
              "basic",
              "focused",
              "comprehensive"
            ]
          },
          "coverage": {
            "title": "Coverage attribute value the assessors applied",
            "enum": [
              "basic",
              "focused",
              "comprehensive"
            ]
          },
          "assessed_on": {
            "title": "When the control was assessed: a date inside sap.yaml schedule (ASMT-005); the POA&M's assessment date derives from it",
            "type": "string",
            "format": "date"
          },
          "gap_closed": {
            "title": "What closed the gap the SSP or a STIG finding records, when the control is determined satisfied (XCON-001)",
            "type": "string",
            "minLength": 1
          },
          "reassessments": {
            "title": "Later reassessments of some determination statements (A-5), kept apart from A-3's results; the latest result of a statement is its current one (ASMT-005)",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task",
                "date",
                "statements",
                "sources"
              ],
              "properties": {
                "task": {
                  "title": "The task that reassessed",
                  "enum": [
                    "A-4",
                    "A-5"
                  ]
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "statements": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "result"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "result": {
                        "enum": [
                          "satisfied",
                          "other-than-satisfied",
                          "not-evaluated"
                        ]
                      }
                    }
                  }
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/source"
                  }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "control_id",
          "title",
          "description",
          "status",
          "severity",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FND-\\d{3}$"
          },
          "control_id": {
            "$ref": "#/$defs/control_id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "closed",
              "risk-accepted"
            ]
          },
          "severity": {
            "$ref": "#/$defs/level",
            "title": "Severity of the weakness or deficiency, the priority the assessor recommends for its remediation",
            "x-enforces": [
              "REQ-SP800-53AR5-0302"
            ]
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "affected_statements": {
            "title": "Parts of the control affected by the finding",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state_difference": {
            "title": "How the actual state differs from the planned or expected state",
            "type": "string",
            "minLength": 1
          },
          "potential_compromise": {
            "title": "Potential compromise to confidentiality, integrity, availability or privacy",
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "confidentiality",
                "integrity",
                "availability",
                "privacy"
              ]
            }
          },
          "triage": {
            "title": "Triage of the assessor finding",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "decided_by",
              "significance",
              "risk_basis",
              "rationale"
            ],
            "properties": {
              "action": {
                "title": "The initial action on the finding",
                "enum": [
                  "immediate-remediation",
                  "remediated",
                  "poam",
                  "inconsequential",
                  "false-positive"
                ]
              },
              "decided_by": {
                "title": "Who determines the initial action",
                "type": "string",
                "pattern": "^PER-[A-Z0-9]+$"
              },
              "significance": {
                "title": "The significance of the finding",
                "$ref": "#/$defs/level"
              },
              "risk_basis": {
                "title": "The risk assessment the decision rests on",
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/source"
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "raised_at": {
            "title": "The task that raised the finding: A-3 when absent, M-2 for an ongoing assessment after authorization, whose POA&M item and risk M-3 owes (SAR-POAM-001, RAR-001)",
            "enum": [
              "A-3",
              "A-5",
              "M-2"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "level": {
      "description": "SP 800-30 qualitative scale.",
      "enum": [
        "very-low",
        "low",
        "moderate",
        "high",
        "very-high"
      ]
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
