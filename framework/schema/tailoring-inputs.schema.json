{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:tailoring-inputs",
  "title": "framework/baselines/tailoring-inputs.yaml",
  "description": "The baseline and overlay assumptions and the overlay conditions Task S-2 tests a system against (TLR-003, TLR-005).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assumptions",
    "overlay_conditions"
  ],
  "properties": {
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "when",
          "citation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AS-[A-Z]+-\\d+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "description": "holds-false: the baselines rest on it, so a system where it fails revisits the selection. holds-true: the baselines do not address it, so a system where it holds supplements.",
            "enum": [
              "holds-false",
              "holds-true"
            ]
          },
          "overlay": {
            "type": "string",
            "pattern": "^CNSSI1253[A-Z]?-[A-Z0-9-]+$"
          },
          "citation": {
            "$ref": "#/$defs/citation"
          },
          "controls": {
            "description": "The controls the overlay tailors out on this assumption (the Space Platform Overlay's Table 1 Associated Controls). Where it does not hold, S-2 revisits each of them (TLR-003).",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
            }
          }
        }
      }
    },
    "overlay_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "overlay",
          "id",
          "question",
          "controls",
          "citation"
        ],
        "properties": {
          "overlay": {
            "type": "string",
            "pattern": "^CNSSI1253[A-Z]?-[A-Z0-9-]+$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/control_id"
            }
          },
          "citation": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "policy_controls": {
      "description": "Controls a policy requires of every system an overlay applies to, so S-2 may not tailor them out (SPCOV-002).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "overlay",
          "authority",
          "text",
          "controls",
          "citation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PC-[A-Z]+-\\d+$"
          },
          "overlay": {
            "type": "string",
            "pattern": "^CNSSI1253[A-Z]?-[A-Z0-9-]+$"
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
            }
          },
          "citation": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "dod_policy_controls": {
      "description": "Controls that carry a duty DoDI 8500.01 places on every networked DoD IS and PIT system, on its ISSO, privileged and authorized users, or through the DoD Component's cybersecurity program, so S-2 may not tailor them out (DPOL-001, DPOL-002, DPOL-003).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "authority",
          "text",
          "controls",
          "citation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PC-DOD-\\d+$"
          },
          "subject": {
            "title": "Who the duty binds: the system; its ISSO, privileged users and authorized users; or the DoD Component's cybersecurity program, carried by the system's controls",
            "enum": [
              "system",
              "users",
              "program"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
            }
          },
          "citation": {
            "$ref": "#/$defs/citation"
          },
          "applies_to": {
            "title": "The system types the duty binds (facts.yaml system_type.value); absent, every system",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "enclave",
                "major-application",
                "pit-system",
                "general-support-system",
                "pit",
                "it-service",
                "it-product"
              ]
            }
          }
        }
      }
    },
    "control_floors": {
      "description": "Controls a source document names, or that alone carry one of its duties, so S-2 may not tailor them out, the SSP may not record them not-applicable, and a compensating control stands for one only with its risk accepted by the AO or AODR (CFLR-001 to CFLR-003).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "authority",
          "text",
          "controls",
          "mapping",
          "citation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CF-[A-Z0-9]+-[A-Z0-9]+$"
          },
          "rule": {
            "title": "The rule that judges the record, one per source family",
            "enum": [
              "CFLR-001",
              "CFLR-002",
              "CFLR-003"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
            }
          },
          "mapping": {
            "title": "How the controls carry the duty: the source names them (named), they alone meet it (sole), or the source names none and several could meet it (proxy, which caps the entry at partial)",
            "enum": [
              "named",
              "sole",
              "proxy"
            ]
          },
          "applies_to": {
            "title": "The system types the duty binds (facts.yaml system_type.value); absent, every system",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "enclave",
                "major-application",
                "pit-system",
                "general-support-system",
                "pit",
                "it-service",
                "it-product"
              ]
            }
          },
          "applies_when": {
            "title": "A condition the duty binds under: cato, a cATO is sought (an AD-CATO record in the ledger, or artifacts/data/cato.yaml)",
            "enum": [
              "cato"
            ]
          },
          "citation": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    }
  },
  "$defs": {
    "control_id": {
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "page",
        "anchor"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
