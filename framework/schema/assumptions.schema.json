{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:assumptions",
  "title": "runs/<run-id>/assumptions.yaml",
  "description": "Tagged assumptions (HYB-001/002); reports/assumptions.md is generated from this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assumptions"
  ],
  "properties": {
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "rationale",
          "task",
          "tag"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ASM-(?:[A-Z]+-)?\\d{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "$ref": "#/$defs/task_id"
          },
          "persona": {
            "description": "Who would confirm it in a real run.",
            "$ref": "#/$defs/persona_id"
          },
          "tag": {
            "const": "ASSUMPTION"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[PCSIARM]-[1-9]\\d?$"
    }
  }
}
