{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:run-config",
  "title": "runs/<run-id>/run.yaml",
  "description": "Run configuration (plan §7.1, §7.3); validated by RUN-CFG-001. Written by rmf run init; the agent edits only humans, scope, seeded, lifecycle_stop*, include_after_stop and deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "run_id",
    "product",
    "as_of",
    "framework_version",
    "git_sha",
    "upstream_hash",
    "oscal_version",
    "humans",
    "scope",
    "seeded",
    "lifecycle_stop",
    "include_after_stop",
    "lifecycle_stop_rationale",
    "deferred"
  ],
  "properties": {
    "mode": {
      "enum": [
        "synthetic",
        "hybrid"
      ]
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "product": {
      "description": "Product directory, relative to the run directory.",
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "description": "RFC 3339; becomes OSCAL metadata.last-modified.",
      "type": "string",
      "format": "date-time"
    },
    "framework_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "git_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "upstream_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oscal_version": {
      "const": "1.2.1"
    },
    "humans": {
      "description": "Personas answered by real people in hybrid mode (name, or null when unassigned).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^PER-[A-Z0-9]+$": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/task_id"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      }
    },
    "seeded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "from_task",
          "path"
        ],
        "properties": {
          "artifact": {
            "$ref": "#/$defs/artifact_id"
          },
          "from_task": {
            "$ref": "#/$defs/task_id"
          },
          "path": {
            "description": "File relative to the run directory (run.yaml) or the seeds directory (scenario).",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lifecycle_stop": {
      "oneOf": [
        {
          "$ref": "#/$defs/task_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "include_after_stop": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task_id"
      },
      "uniqueItems": true
    },
    "lifecycle_stop_rationale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "deferred": {
      "description": "Explicit deferrals (plan §7.3 precedence 2).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[PCSIARM]-[1-9]\\d?$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rationale"
          ],
          "properties": {
            "kind": {
              "enum": [
                "not-applicable",
                "performed-externally",
                "later-cycle"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "control_subset": {
      "description": "Test scenarios only: restrict the resolved baseline to these controls.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/control_id"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ART-[A-Z]+(?:-[A-Z]+)*$"
    },
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,40}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[PCSIARM]-[1-9]\\d?$"
    }
  }
}
