{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:run-config",
  "title": "runs/<run-id>/run.yaml",
  "description": "Run configuration (plan §7.1, §7.3); validated by RUN-CFG-001. Written by rmf run init; the agent edits only humans, scope, seeded, lifecycle_stop*, include_after_stop and deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "run_id",
    "product",
    "as_of",
    "framework_version",
    "git_sha",
    "upstream_hash",
    "oscal_version",
    "humans",
    "scope",
    "seeded",
    "lifecycle_stop",
    "include_after_stop",
    "lifecycle_stop_rationale",
    "deferred"
  ],
  "properties": {
    "mode": {
      "enum": [
        "synthetic",
        "hybrid"
      ]
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "product": {
      "description": "Product directory, relative to the run directory.",
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "description": "RFC 3339; becomes OSCAL metadata.last-modified.",
      "type": "string",
      "format": "date-time"
    },
    "framework_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "git_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "upstream_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "upstream_hash_basis": {
      "description": "Which globs upstream_hash covers (ADR-0001; RUN-STALE-001): the union globs, or a scenario's hash_globs. Absent means union.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant"
      ],
      "properties": {
        "variant": {
          "enum": [
            "union",
            "scenario"
          ]
        },
        "scenario": {
          "description": "The scenario file, relative to the repository root.",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "variant": {
            "const": "scenario"
          }
        }
      },
      "then": {
        "required": [
          "scenario"
        ]
      },
      "else": {
        "not": {
          "required": [
            "scenario"
          ]
        }
      }
    },
    "oscal_version": {
      "const": "1.2.1"
    },
    "humans": {
      "description": "Personas answered by real people in hybrid mode (name, or null when unassigned).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^PER-[A-Z0-9]+$": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/task_id"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      }
    },
    "seeded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "from_task",
          "path"
        ],
        "properties": {
          "artifact": {
            "$ref": "#/$defs/artifact_id"
          },
          "from_task": {
            "$ref": "#/$defs/task_id"
          },
          "path": {
            "description": "File relative to the run directory (run.yaml) or the seeds directory (scenario).",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lifecycle_stop": {
      "oneOf": [
        {
          "$ref": "#/$defs/task_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "include_after_stop": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task_id"
      },
      "uniqueItems": true
    },
    "lifecycle_stop_rationale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "deferred": {
      "description": "Explicit deferrals (plan §7.3 precedence 2).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[PCSIARM]-[1-9]\\d?$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rationale"
          ],
          "properties": {
            "kind": {
              "enum": [
                "not-applicable",
                "performed-externally",
                "later-cycle"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "control_subset": {
      "description": "Test scenarios only: restrict the resolved baseline to these controls.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/control_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "entry": {
      "title": "Where the run enters the RMF and why, when not at P-1: the assessment of the system's current state, the activities already completed, the gaps, the decision, who was notified and who approved",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "task",
        "current_state",
        "completed",
        "gaps",
        "decision",
        "notified",
        "approved_by"
      ],
      "properties": {
        "step": {
          "enum": [
            "P",
            "C",
            "S",
            "I",
            "A",
            "R",
            "M"
          ]
        },
        "task": {
          "type": "string",
          "pattern": "^[PCSIARM]-[1-9]\\d?$"
        },
        "current_state": {
          "title": "Assessment of the current state of the system",
          "type": "string",
          "minLength": 1
        },
        "completed": {
          "title": "RMF tasks whose activities are already completed for the system",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[PCSIARM]-[1-9]\\d?$"
          }
        },
        "gaps": {
          "title": "What the gap analysis found missing or out of date",
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "title": "The entry decision and its rationale",
          "type": "string",
          "minLength": 1
        },
        "notified": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^PER-[A-Z0-9]+$"
          }
        },
        "approved_by": {
          "type": "string",
          "pattern": "^PER-[A-Z0-9]+$"
        },
        "deficiencies": {
          "title": "Control deficiencies the gap analysis of an existing system found",
          "description": "An empty list when none; OMP-001 requires it at an entry to step M.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ART-[A-Z]+(?:-[A-Z]+)*$"
    },
    "control_id": {
      "description": "OSCAL control id from the catalog (ac-2, ac-2.1).",
      "type": "string",
      "pattern": "^[a-z]{2}-\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,40}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[PCSIARM]-[1-9]\\d?$"
    }
  }
}
