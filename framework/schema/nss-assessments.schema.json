{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:nss-assessments",
  "title": "runs/<run-id>/artifacts/data/nss-assessments.yaml",
  "description": "For a National Security System, NSA's assessment with the cognizant AO of its cybersecurity requirements and security architecture, and for a space NSS the coordination, verification and reports to the AO and NSA, as P-16 records them. PPROT-006 judges it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nss",
    "assessments",
    "architecture_coordination",
    "preexisting_components",
    "compliance_reports",
    "sources"
  ],
  "properties": {
    "nss": {
      "title": "Whether the system is a National Security System",
      "type": "boolean"
    },
    "assessments": {
      "title": "Assessments of the cybersecurity requirements and information system security architecture",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_point",
          "assessed_by",
          "covers",
          "date"
        ],
        "properties": {
          "decision_point": {
            "$ref": "#/$defs/decision_point"
          },
          "assessed_by": {
            "title": "Who assessed the cybersecurity requirements and security architecture: NSA and the cognizant AO",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "covers": {
            "title": "What the assessment covers",
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "cybersecurity-requirements",
                "security-architecture"
              ]
            }
          },
          "date": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "architecture_coordination": {
      "title": "Coordination of the space NSS security architecture with the cognizant AO and NSA",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "with"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "with": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "preexisting_components": {
      "title": "Pre-existing components or services verified with the cognizant AO and NSA before inclusion",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "verified_with",
          "verified",
          "included"
        ],
        "properties": {
          "component": {
            "$ref": "#/$defs/text"
          },
          "verified_with": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "verified": {
            "$ref": "#/$defs/date"
          },
          "included": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "compliance_reports": {
      "title": "Reports of the compliance status of the space NSS to the cognizant AO and NSA",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "to"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "date": {
      "description": "ISO date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "decision_point": {
      "description": "A milestone of framework/milestones.yaml or a decision point of framework/pathways.yaml.",
      "type": "string",
      "pattern": "^(MS|DP)-[A-Z0-9-]+$"
    }
  }
}
