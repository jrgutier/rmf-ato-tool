{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:infotypes",
  "title": "runs/<run-id>/artifacts/data/infotypes.yaml",
  "description": "Information types and their life cycle (P-12, P-13); OSCAL SSP system-characteristics.system-information.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "information_types"
  ],
  "properties": {
    "information_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "sp800_60_ids",
          "confidentiality",
          "integrity",
          "availability",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INF-\\d{2,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sp800_60_ids": {
            "description": "SP 800-60 Vol. 2 identifiers (e.g. C.3.5.1); empty for organization-defined types.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[CD](?:\\.\\d+){1,3}$"
            }
          },
          "confidentiality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/impact"
              },
              "selected": {
                "$ref": "#/$defs/impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "integrity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/impact"
              },
              "selected": {
                "$ref": "#/$defs/impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/impact"
              },
              "selected": {
                "$ref": "#/$defs/impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "privacy": {
            "description": "Contains PII.",
            "type": "boolean"
          },
          "life_cycle": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "description"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "creation",
                    "collection",
                    "processing",
                    "storage",
                    "use",
                    "maintenance",
                    "dissemination",
                    "disclosure",
                    "disposition"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "components": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/component_ref"
                  }
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "component_ref": {
      "type": "string",
      "pattern": "^(CMP-[A-Z0-9-]+|this-system)$"
    },
    "impact": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
