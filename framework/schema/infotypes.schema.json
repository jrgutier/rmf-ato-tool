{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:infotypes",
  "title": "runs/<run-id>/artifacts/data/infotypes.yaml",
  "description": "Information types and their life cycle (P-12, P-13); OSCAL SSP system-characteristics.system-information.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "information_types"
  ],
  "properties": {
    "information_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "sp800_60_ids",
          "confidentiality",
          "integrity",
          "availability",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INF-\\d{2,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sp800_60_ids": {
            "description": "SP 800-60 Vol. 2 identifiers (e.g. C.3.5.1); empty for organization-defined types.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[CD](?:\\.\\d+){1,3}$"
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0086"
            ],
            "title": "SP 800-60 Volume II identifiers of the information type, by business area and line of business"
          },
          "confidentiality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/impact"
              },
              "selected": {
                "$ref": "#/$defs/impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0102"
            ],
            "title": "Confidentiality impact of the information type: provisional (base) and selected level, with the adjustment justification"
          },
          "integrity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/impact"
              },
              "selected": {
                "$ref": "#/$defs/impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0107"
            ],
            "title": "Integrity impact of the information type: provisional (base) and selected level, with the adjustment justification"
          },
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/impact"
              },
              "selected": {
                "$ref": "#/$defs/impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0121"
            ],
            "title": "Availability impact of the information type: provisional (base) and selected level, with the adjustment justification"
          },
          "privacy": {
            "description": "Contains PII.",
            "type": "boolean"
          },
          "life_cycle": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "description"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "creation",
                    "collection",
                    "processing",
                    "storage",
                    "use",
                    "maintenance",
                    "dissemination",
                    "disclosure",
                    "disposition"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "components": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/component_ref"
                  }
                }
              }
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0103"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "selection_basis": {
            "title": "Why the information type was selected: the mission or business function it supports and the governance that applies to it",
            "type": "string",
            "minLength": 1
          },
          "pii_identification": {
            "title": "How PII in the type was identified, including identifiers that only identify an individual in combination",
            "type": "string",
            "minLength": 1
          },
          "system_information": {
            "title": "Whether the type is system information (routing tables, password files, cryptographic key management, configuration and security policy information)",
            "type": "boolean"
          },
          "handling": {
            "title": "Special handling of the type: classification, CUI, CTI, software artifacts with a military or space application, and other special handling",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "classification",
              "cui",
              "cti",
              "software_artifacts"
            ],
            "properties": {
              "classification": {
                "title": "Classification level of the information",
                "enum": [
                  "unclassified",
                  "confidential",
                  "secret",
                  "top-secret"
                ]
              },
              "cui": {
                "title": "Whether the information is controlled unclassified information",
                "type": "boolean"
              },
              "cti": {
                "title": "Whether the information is controlled technical information",
                "type": "boolean",
                "x-enforces": [
                  "REQ-DOWI8430.01-0235"
                ]
              },
              "software_artifacts": {
                "title": "Whether the type is software or technical artifacts (source code, build scripts, SBOMs, test vectors, design documents) with a specific military or space application",
                "type": "boolean",
                "x-enforces": [
                  "REQ-DOWI8430.01-0236"
                ]
              },
              "special": {
                "title": "Other special handling, such as the Privacy Act, trade secrets or critical infrastructure information",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "privacy-act",
                    "trade-secret",
                    "critical-infrastructure",
                    "export-controlled",
                    "other"
                  ]
                },
                "x-enforces": [
                  "REQ-SP800-60V1R1-0161",
                  "REQ-SP800-60V1R1-0132",
                  "REQ-SP800-60V1R1-0166"
                ]
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "cti": {
      "title": "How controlled technical information is protected where it leaves the system (DoDI 5000.83): the exposure on unclassified networks, the DFARS clause, the DoDI 8582.01 terms in agreements and losses from reported incidents",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "protection",
        "agreements_include_8582",
        "incident_losses"
      ],
      "properties": {
        "exposure": {
          "title": "The impact of exposure of the CTI placed on unclassified networks",
          "type": "string",
          "minLength": 1
        },
        "protection": {
          "title": "How CTI protection is held: DFARS 252.204-7012, or exempted by DFARS 252.204-7000(a)(3)",
          "enum": [
            "dfars-252.204-7012",
            "exempt-dfars-252.204-7000-a-3"
          ]
        },
        "agreements_include_8582": {
          "title": "Whether the legally binding agreements include the DoDI 8582.01 requirements",
          "type": "boolean"
        },
        "incident_losses": {
          "title": "Losses assessed from cyber incidents reported under contracts with the DFARS clauses",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-DODI5000.83-0154"
          ]
        }
      }
    }
  },
  "$defs": {
    "component_ref": {
      "type": "string",
      "pattern": "^(CMP-[A-Z0-9-]+|this-system)$"
    },
    "impact": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
