{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:infotypes",
  "title": "runs/<run-id>/artifacts/data/infotypes.yaml",
  "description": "Information types and their life cycle (P-12, P-13); OSCAL SSP system-characteristics.system-information.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "information_types"
  ],
  "properties": {
    "information_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "sp800_60_ids",
          "confidentiality",
          "integrity",
          "availability",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INF-\\d{2,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sp800_60_ids": {
            "description": "SP 800-60 Vol. 2 identifiers (e.g. C.3.5.1); empty for organization-defined types.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[CD](?:\\.\\d+){1,3}$"
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0086"
            ],
            "title": "SP 800-60 Volume II identifiers of the information type, by business area and line of business"
          },
          "confidentiality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/confidentiality_impact",
                "title": "Provisional confidentiality impact of the information type: low, moderate, high, or not applicable, a value that only applies to the confidentiality of an information type",
                "x-enforces": [
                  "REQ-FIPS199-0017",
                  "REQ-FIPS199-0031",
                  "REQ-SP800-60V1R1-0060",
                  "REQ-SP800-60V1R1-0096",
                  "REQ-SP800-60V1R1-0199"
                ]
              },
              "selected": {
                "$ref": "#/$defs/confidentiality_impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0102"
            ],
            "title": "Confidentiality impact of the information type: provisional (base) and selected level, with the adjustment justification"
          },
          "integrity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/impact",
                "title": "Provisional integrity impact of the information type: low, moderate or high; not applicable only applies to confidentiality",
                "x-enforces": [
                  "REQ-FIPS199-0017",
                  "REQ-SP800-60V1R1-0060"
                ]
              },
              "selected": {
                "$ref": "#/$defs/impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0107"
            ],
            "title": "Integrity impact of the information type: provisional (base) and selected level, with the adjustment justification"
          },
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "$ref": "#/$defs/impact",
                "title": "Provisional availability impact of the information type: low, moderate or high; not applicable only applies to confidentiality",
                "x-enforces": [
                  "REQ-FIPS199-0017",
                  "REQ-SP800-60V1R1-0060"
                ]
              },
              "selected": {
                "$ref": "#/$defs/impact"
              },
              "adjustment_justification": {
                "type": "string",
                "minLength": 1
              }
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0121"
            ],
            "title": "Availability impact of the information type: provisional (base) and selected level, with the adjustment justification"
          },
          "privacy": {
            "description": "Contains PII.",
            "type": "boolean"
          },
          "life_cycle": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "description"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "creation",
                    "collection",
                    "processing",
                    "storage",
                    "use",
                    "maintenance",
                    "dissemination",
                    "disclosure",
                    "disposition"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "components": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/component_ref"
                  }
                }
              }
            },
            "x-enforces": [
              "REQ-SP800-60V1R1-0103"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "selection_basis": {
            "title": "Why the information type was selected: the mission or business function it supports and the governance that applies to it",
            "type": "string",
            "minLength": 1
          },
          "pii_identification": {
            "title": "How PII in the type was identified, including identifiers that only identify an individual in combination",
            "type": "string",
            "minLength": 1
          },
          "system_information": {
            "title": "Whether the type is system information (routing tables, password files, cryptographic key management, configuration and security policy information)",
            "type": "boolean"
          },
          "handling": {
            "title": "Special handling of the type: classification, CUI, CTI, software artifacts with a military or space application, and other special handling",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "classification",
              "cui",
              "cti",
              "software_artifacts"
            ],
            "properties": {
              "classification": {
                "title": "Classification level of the information",
                "enum": [
                  "unclassified",
                  "confidential",
                  "secret",
                  "top-secret"
                ]
              },
              "cui": {
                "title": "Whether the information is controlled unclassified information",
                "type": "boolean"
              },
              "cti": {
                "title": "Whether the information is controlled technical information",
                "type": "boolean",
                "x-enforces": [
                  "REQ-DOWI8430.01-0235"
                ]
              },
              "software_artifacts": {
                "title": "Whether the type is software or technical artifacts (source code, build scripts, SBOMs, test vectors, design documents) with a specific military or space application",
                "type": "boolean",
                "x-enforces": [
                  "REQ-DOWI8430.01-0236"
                ]
              },
              "special": {
                "title": "Other special handling, such as the Privacy Act, trade secrets or critical infrastructure information",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "privacy-act",
                    "trade-secret",
                    "critical-infrastructure",
                    "export-controlled",
                    "other"
                  ]
                },
                "x-enforces": [
                  "REQ-SP800-60V1R1-0161",
                  "REQ-SP800-60V1R1-0132",
                  "REQ-SP800-60V1R1-0166"
                ]
              }
            }
          },
          "pii": {
            "title": "Whom the PII is about and whether it holds PHI or SSNs",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subjects",
              "phi",
              "ssn"
            ],
            "properties": {
              "subjects": {
                "title": "Whom the PII in this information type is about",
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "public",
                    "federal-personnel",
                    "contractors",
                    "foreign-nationals-us-facilities-abroad",
                    "foreign-nationals-other"
                  ]
                }
              },
              "phi": {
                "title": "The information type holds protected health information",
                "type": "boolean"
              },
              "ssn": {
                "title": "The information type holds Social Security numbers",
                "type": "boolean"
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "cti": {
      "title": "How controlled technical information is protected where it leaves the system (DoDI 5000.83): the exposure on unclassified networks, the DFARS clause, the DoDI 8582.01 terms in agreements and losses from reported incidents",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "protection",
        "agreements_include_8582",
        "incident_losses"
      ],
      "properties": {
        "exposure": {
          "title": "The impact of exposure of the CTI placed on unclassified networks",
          "type": "string",
          "minLength": 1
        },
        "protection": {
          "title": "How CTI protection is held: DFARS 252.204-7012, or exempted by DFARS 252.204-7000(a)(3)",
          "enum": [
            "dfars-252.204-7012",
            "exempt-dfars-252.204-7000-a-3"
          ]
        },
        "agreements_include_8582": {
          "title": "Whether the legally binding agreements include the DoDI 8582.01 requirements",
          "type": "boolean"
        },
        "incident_losses": {
          "title": "Losses assessed from cyber incidents reported under contracts with the DFARS clauses",
          "type": "string",
          "minLength": 1,
          "x-enforces": [
            "REQ-DODI5000.83-0154"
          ]
        }
      }
    },
    "privacy": {
      "title": "Privacy compliance record of a system processing PII (P-12; PRIV-001)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compliance",
        "sorn",
        "records",
        "pia",
        "sources"
      ],
      "properties": {
        "compliance": {
          "title": "DoD issuances the system's handling of PII and PHI complies with",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "DOD5400.11-R",
              "DODI5400.16",
              "DOD8580.02",
              "DODM6025.18",
              "DODI1000.30",
              "DODI5015.02"
            ]
          }
        },
        "sorn": {
          "title": "System of records notice covering the PII",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sources"
          ],
          "properties": {
            "status": {
              "title": "System of records notice status",
              "enum": [
                "published",
                "pending",
                "not-required"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "contractor_operated": {
              "title": "A contractor operates the system of records on behalf of DoD",
              "type": "boolean"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "ssn_justification": {
          "title": "Justification of Social Security number use",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memo",
            "sources"
          ],
          "properties": {
            "memo": {
              "title": "SSN use and justification memorandum",
              "type": "string",
              "minLength": 1
            },
            "scop_signed": {
              "$ref": "#/$defs/date"
            },
            "dpcltd_approved": {
              "$ref": "#/$defs/date"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "records": {
          "title": "Records management coordination for the records the system creates",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "office",
            "schedule",
            "sources"
          ],
          "properties": {
            "office": {
              "title": "Records management office coordinated with",
              "type": "string",
              "minLength": 1
            },
            "schedule": {
              "title": "NARA-approved records schedule the PII records follow",
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "pia": {
          "title": "PIA determination",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "determination",
            "basis",
            "sources"
          ],
          "properties": {
            "determination": {
              "title": "Whether a PIA is required, adapted or not required",
              "enum": [
                "required",
                "adapted",
                "not-required"
              ]
            },
            "basis": {
              "title": "DoDI 5400.16 basis of the determination",
              "enum": [
                "pii-in-electronic-form",
                "existing-no-pia",
                "new-system",
                "paper-to-electronic",
                "anonymous-to-pii",
                "third-party-website",
                "no-pii",
                "nss",
                "internal-government-operations",
                "previously-assessed",
                "unchanged",
                "feedback-website",
                "matching-agreement",
                "statistical-agreement"
              ]
            },
            "due": {
              "title": "When the PIA is due: before development, procurement or contract, or a date",
              "type": "string",
              "minLength": 1
            },
            "privacy_implications": {
              "title": "Privacy implications considered for an NSS excluded from the PIA requirement",
              "type": "string",
              "minLength": 1
            },
            "previous_assessment": {
              "title": "The earlier PIA or PIA-like evaluation (such as a data use agreement) a previously-assessed or unchanged basis rests on",
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "basis"
                ],
                "properties": {
                  "basis": {
                    "enum": [
                      "previously-assessed",
                      "unchanged"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "previous_assessment"
                ]
              }
            }
          ]
        },
        "redetermined_after": {
          "title": "Changes creating new privacy risk after which P-12 decided the PIA again",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CHG-\\d{3}$"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  },
  "$defs": {
    "component_ref": {
      "type": "string",
      "pattern": "^(CMP-[A-Z0-9-]+|this-system)$"
    },
    "impact": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "confidentiality_impact": {
      "enum": [
        "low",
        "moderate",
        "high",
        "not-applicable"
      ]
    }
  }
}
