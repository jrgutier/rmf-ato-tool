{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:cato",
  "title": "runs/<run-id>/artifacts/data/cato.yaml",
  "description": "What a cATO application shows (M-6; DoD CIO cATO Implementation Guide and Evaluation Criteria): the assessment and its scoring against Table 2 of the guide, the DevSecOps platform, its monitoring, the strategy's triggers, metrics, people, training, process, risk tolerances, the activities mapping and the SBOM. CATO-001..011 judge it whenever it exists and require it once the ledger holds an AD-CATO record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "use_case",
    "underlying",
    "assessment",
    "platform",
    "monitoring",
    "strategy",
    "metrics",
    "people",
    "training",
    "process",
    "tolerances",
    "activities_mapping",
    "sbom",
    "sources"
  ],
  "properties": {
    "use_case": {
      "title": "IG Appendix A use case: production inside or outside the software factory",
      "type": "string"
    },
    "underlying": {
      "title": "The ledger record of the ATO the cATO rests on",
      "type": "string"
    },
