        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "team": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approved_by": {
              "type": "string",
              "minLength": 1
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "trained_on_method": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "trained_on_method"
                ]
