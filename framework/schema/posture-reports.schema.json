{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:posture-reports",
  "title": "runs/<run-id>/artifacts/data/posture-reports.yaml",
  "description": "Status data behind ART-SECRPT (M-5): each posture report, its marking and deliveries, the status DoD bodies receive, and the organization tier's review. MRPT-001 and MRPT-002 judge it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reports",
    "organization_tier",
    "sources"
  ],
  "properties": {
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "period",
          "issued",
          "marking",
          "deliveries",
          "scorecard",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SPR-\\d{3}$"
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/date"
              },
              "to": {
                "$ref": "#/$defs/date"
              }
            }
          },
          "issued": {
            "$ref": "#/$defs/date"
          },
          "plan_changes": {
            "title": "Versions of the security and privacy plan changes (plan-reviews.yaml changes) the report summarizes, each made since the last report (MRPT-003)",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "marking": {
            "title": "Marking of the security and privacy posture report, marked and protected",
            "enum": [
              "CUI",
              "CONFIDENTIAL",
              "SECRET",
              "TOP SECRET"
            ],
            "x-enforces": [
              "REQ-SP800-37R2-0452"
            ]
          },
          "deliveries": {
            "title": "Who received the report and what they received",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "recipient",
                "date",
                "content"
              ],
              "properties": {
                "recipient": {
                  "title": "A persona or an outside body",
                  "type": "string",
                  "pattern": "^(PER-[A-Z0-9]+|CDRUSSTRATCOM|DISA|DIA|USCYBERCOM|JFHQ-DODIN)$"
                },
                "date": {
                  "$ref": "#/$defs/date"
                },
                "content": {
                  "title": "What the delivery carries",
                  "type": "array",
                  "items": {
                    "enum": [
                      "posture",
                      "poam",
                      "findings",
                      "vulnerability-reports"
                    ]
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 1
          },
          "scorecard": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reported"
            ],
            "properties": {
              "reported": {
                "$ref": "#/$defs/date",
                "title": "Date of cybersecurity scorecard reporting"
              },
              "vdp_metrics": {
                "title": "Key VDP metrics carried to the DoD Cybersecurity Scorecard",
                "type": "boolean"
              }
            }
          },
          "cmrs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "automated_process"
            ],
            "properties": {
              "method": {
                "title": "How compliance reporting statistics reach the Continuous Monitoring and Risk Scoring system of record",
                "enum": [
                  "automated",
                  "manual",
                  "none"
                ]
              },
              "automated_process": {
                "title": "State of the automated process",
                "enum": [
                  "developed",
                  "in-development",
                  "not-possible"
                ]
              }
            }
          },
          "findings_shared": {
            "title": "Outside findings shared in this report",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EXF-\\d{3}$"
            }
          },
          "vulnerability_status": {
            "title": "Mitigation and risk acceptance status reported to JFHQ-DODIN",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "poam_item",
                "status"
              ],
              "properties": {
                "poam_item": {
                  "type": "string",
                  "pattern": "^POAM-\\d{3}$"
                },
                "status": {
                  "enum": [
                    "open",
                    "ongoing",
                    "completed",
                    "risk-accepted"
                  ]
                }
              }
            }
          },
          "service_changes": {
            "title": "Status changes of external services reported through the network operations chain of command",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "change",
                "reported_to",
                "via",
                "date"
              ],
              "properties": {
                "change": {
                  "type": "string",
                  "pattern": "^CHG-\\d{3}$"
                },
                "reported_to": {
                  "title": "End of the chain of command",
                  "enum": [
                    "USCYBERCOM"
                  ]
                },
                "via": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "$ref": "#/$defs/date"
                }
              }
            }
          },
          "sharing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "display",
              "audiences",
              "qualities"
            ],
            "properties": {
              "display": {
                "title": "How DODIN operations and cybersecurity data are displayed",
                "enum": [
                  "automated",
                  "manual"
                ]
              },
              "audiences": {
                "title": "Organizations the status data is shared with, vertically and horizontally",
                "type": "array",
                "items": {
                  "enum": [
                    "superior",
                    "subordinate",
                    "peer",
                    "mission-partner"
                  ]
                }
              },
              "qualities": {
                "title": "What the shared data is",
                "type": "array",
                "items": {
                  "enum": [
                    "visible",
                    "accessible",
                    "understandable",
                    "trusted",
                    "interoperable"
                  ]
                }
              }
            }
          },
          "sources": {
            "$ref": "#/$defs/sources"
          }
        }
      }
    },
    "organization_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviews",
        "open_poam_items",
        "feeds"
      ],
      "properties": {
        "reviews": {
          "title": "Review of status reports by the risk executive (function) and the CISO",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "reviewed",
              "determination"
            ],
            "properties": {
              "by": {
                "$ref": "#/$defs/persona_id",
                "title": "Tier 1 or 2 official who reviews the status reports"
              },
              "reviewed": {
                "$ref": "#/$defs/date"
              },
              "determination": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "open_poam_items": {
          "title": "Aggregate POA&M information: the count of open items",
          "type": "integer",
          "minimum": 0
        },
        "feeds": {
          "title": "Task the organization tier review feeds",
          "const": "P-7"
        }
      }
    },
    "sources": {
      "$ref": "#/$defs/sources"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  }
}
