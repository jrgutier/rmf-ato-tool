{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:inventory",
  "title": "runs/<run-id>/artifacts/data/inventory.yaml",
  "description": "Hardware and software inventory (P-10; updated by I-2, M-1); OSCAL SSP system-implementation.inventory-items. Every component is a boundary component (INV-BND-001).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "kind",
          "component",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-\\d{3}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "hardware",
              "software",
              "operating-system",
              "firmware",
              "virtual-machine",
              "network-device",
              "database",
              "service"
            ]
          },
          "component": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9-]+$"
          },
          "vendor": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "hostname": {
            "type": "string",
            "minLength": 1
          },
          "virtual": {
            "type": "boolean"
          },
          "public": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
