{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:pm-scrm",
  "title": "runs/<run-id>/artifacts/data/pm-scrm.yaml",
  "description": "The program manager's supply chain risk management actions (DoDI 5000.90 3.4) P-14 writes beside ART-RA: market research of vendors, illumination of the supply chain, the risk tolerance level and the Table 1 due diligence it calls for, DIA SCRM TAC requests and their reports, the assured supplier or countermeasure of each mission-critical item, validated products, and for a space NSS the acquisition and engineering mitigations and the threat information behind them. PMSCRM-001 and PMSCRM-002 judge it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "started",
    "risk_tolerance",
    "actions",
    "not_taken",
    "market_research",
    "illumination",
    "tac_requests",
    "reports",
    "mission_critical",
    "unvalidated_products",
    "threat_information",
    "mitigations",
    "sources"
  ],
  "properties": {
    "started": {
      "title": "When the program began applying supply chain risk management practices",
      "$ref": "#/$defs/date"
    },
    "risk_tolerance": {
      "title": "Supply chain risk tolerance level of the system or mission, linked to the importance of the systems purchased",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "procurement",
        "basis"
      ],
      "properties": {
        "level": {
          "title": "Risk tolerance level of DoDI 5000.90 Table 1",
          "enum": [
            "high",
            "moderate",
            "low",
            "very-low"
          ]
        },
        "basis": {
          "$ref": "#/$defs/text"
        },
        "procurement": {
          "title": "Kind of procurement the risk tolerance level applies to: simplified, structured, engineered or assured",
          "enum": [
            "simplified",
            "structured",
            "engineered",
            "assured"
          ]
        }
      }
    },
    "actions": {
      "title": "SCRM due diligence actions of DoDI 5000.90 Table 1 the PM takes",
      "type": "array",
      "items": {
        "enum": [
          "foci-caution",
          "approved-products-lists",
          "industry-standards",
          "balance-risk-mission",
          "verifiable-vendor-processes",
          "vendor-limitations-awareness",
          "countermeasures-critical-risks",
          "assess-critical-components",
          "implement-countermeasures",
          "assessment-vendors",
          "follow-dodi5200.44-sp800-161",
          "criticality-analysis",
          "ppp-documentation",
          "tac-requests",
          "flag-reports"
        ]
      },
      "uniqueItems": true,
      "x-enforces": [
        "REQ-DODI5000.90-0068",
        "REQ-DODI5000.90-0123"
      ]
    },
    "not_taken": {
      "title": "Table 1 actions the PM does not take, each with the reason (the table says should)",
      "type": "array",
      "items": {
        "title": "",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "reason"
        ],
        "properties": {
          "action": {
            "$ref": "#/$defs/text"
          },
          "reason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "market_research": {
      "title": "Market research assessing potential vendors",
      "type": "array",
      "items": {
        "title": "",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "date",
          "findings"
        ],
        "properties": {
          "vendor": {
            "$ref": "#/$defs/text"
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "findings": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "minItems": 1,
      "x-enforces": [
        "REQ-DODI5000.90-0108"
      ]
    },
    "illumination": {
      "title": "Whether the PM maintains a visualization (illumination) of the supply chain, and what was weighed",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintained",
        "considered"
      ],
      "properties": {
        "maintained": {
          "type": "boolean"
        },
        "considered": {
          "$ref": "#/$defs/text"
        }
      },
      "x-enforces": [
        "REQ-DODI5000.90-0112"
      ]
    },
    "tac_requests": {
      "title": "Requests on critical components or suppliers sent to the DIA SCRM TAC or other counterintelligence sources",
      "type": "array",
      "items": {
        "title": "",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subjects",
          "to",
          "date"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "subjects": {
            "title": "",
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            },
            "minItems": 1
          },
          "to": {
            "title": "Where the request was sent",
            "enum": [
              "DIA-SCRM-TAC",
              "other-CI"
            ]
          },
          "date": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "reports": {
      "title": "Reports that came back on those requests",
      "type": "array",
      "items": {
        "title": "",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "request",
          "rating",
          "flagged"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "request": {
            "$ref": "#/$defs/text"
          },
          "rating": {
            "title": "Risk rating of the report",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "flagged": {
            "type": "boolean"
          },
          "mitigation": {
            "title": "Mitigation decision made through the scoping and mitigations process",
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "mission_critical": {
      "title": "The assured supplier or SCRM countermeasure of each system element that performs a mission-critical function",
      "type": "array",
      "items": {
        "title": "",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "measure",
          "detail"
        ],
        "properties": {
          "item": {
            "$ref": "#/$defs/text"
          },
          "measure": {
            "title": "Assured supplier or appropriate SCRM countermeasure",
            "enum": [
              "assured-supplier",
              "scrm-countermeasure"
            ]
          },
          "detail": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "unvalidated_products": {
      "title": "IA or IA-enabled products used without a validated product, and why",
      "type": "array",
      "items": {
        "title": "",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "reason",
          "detail"
        ],
        "properties": {
          "item": {
            "$ref": "#/$defs/text"
          },
          "reason": {
            "title": "Why no validated product, solution or service is used",
            "enum": [
              "not-available",
              "not-cost-effective"
            ]
          },
          "detail": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "threat_information": {
      "title": "Supply chain threat information the mitigations are informed by",
      "type": "array",
      "items": {
        "title": "",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "date"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "title": "Whether the information is all-source supply chain threat information",
            "enum": [
              "all-source",
              "other"
            ]
          },
          "date": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "mitigations": {
      "title": "Acquisition and engineering mitigations of supply chain risk",
      "type": "array",
      "items": {
        "title": "",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "measure",
          "informed_by"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "title": "Acquisition or engineering mitigation",
            "enum": [
              "acquisition",
              "engineering"
            ]
          },
          "measure": {
            "$ref": "#/$defs/text"
          },
          "informed_by": {
            "title": "Threat information that informs it",
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "sources": {
      "$ref": "#/$defs/sources"
    }
  },
  "$defs": {
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    },
    "date": {
      "description": "ISO date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  }
}
