{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rmf-tool:schema:decision",
  "title": "runs/<run-id>/artifacts/data/decision.yaml",
  "description": "The authorization decision behind ART-AODM (R-4; updated by M-6). Decision type, ATD, conditions, RAR reference and degraded disclosure are AODM-001.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "decided_by",
    "date",
    "rationale",
    "sources"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "pattern": "^AD-[A-Z]{2,6}$"
    },
    "decided_by": {
      "$ref": "#/$defs/persona_id"
    },
    "date": {
      "$ref": "#/$defs/date"
    },
    "authorization_termination_date": {
      "$ref": "#/$defs/date"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^COND-\\d{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "due": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "risk_level": {
      "$ref": "#/$defs/level"
    },
    "rar_ref": {
      "const": "ART-RAR"
    },
    "degraded_disclosure": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "level": {
      "description": "SP 800-30 qualitative scale.",
      "enum": [
        "very-low",
        "low",
        "moderate",
        "high",
        "very-high"
      ]
    },
    "persona_id": {
      "type": "string",
      "pattern": "^PER-[A-Z0-9]+$"
    },
    "source": {
      "description": "Trace token: an interview answer (INT-007.A3), an assumption (ASM-012, ASM-BASELINE-001), a product file with optional anchor (product/architecture.md#identity) or an artifact (ART-SSP).",
      "type": "string",
      "pattern": "^(INT-\\d{3}\\.A\\d+|ASM-(?:[A-Z]+-)?\\d{3}|product/[^\\s#]+(?:#[A-Za-z0-9_.-]+)?|ART-[A-Z]+(?:-[A-Z]+)*)$"
    }
  }
}
