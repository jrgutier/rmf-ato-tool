        "findings": [
          {
            "uuid": "3ac9a506-174b-5dc6-b505-5348d291e126",
            "title": "Shared field-technician account fieldtech is not attributable and not managed on team departure",
            "description": "AC-2 requires accounts to be managed, including changing shared or group account authenticators when individuals are removed from the group, and account use to be monitored. The 2026-09-12 account review and the ISSO interview show the shared local account fieldtech is used by 10 field technicians, its password changes every 90 days and not when a technician leaves the team, and its sign-ins cannot be tied to a person. Release 2.3 (planned 2027-03) replaces it with per-technician accounts; nothing has changed on fielded units.",
            "props": [
              {
                "name": "finding-id",
                "ns": "urn:rmf-tool:oscal",
                "value": "FND-001"
              },
