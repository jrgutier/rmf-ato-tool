        "risks": [
          {
            "uuid": "36d4d45b-415f-508d-8571-ca06eeccef0d",
            "title": "Exploitation of known vulnerabilities on fielded units behind on updates",
            "description": "An outsider with a foothold on the installation network (TE-2) exploits one of the 4 high or 9 medium vulnerabilities on units running a 63-day-old update bundle, because updates reach fielded units only at quarterly site visits; a compromised gateway could falsify or suppress intrusion alarms.",
            "statement": "Likelihood moderate and impact high give a moderate risk level (SP 800-30); response: mitigate.",
            "props": [
              {
                "name": "risk-id",
                "ns": "urn:rmf-tool:oscal",
                "value": "RSK-001"
              },
              {
                "name": "response",
                "ns": "urn:rmf-tool:oscal",
                "value": "mitigate"
              },
              {
