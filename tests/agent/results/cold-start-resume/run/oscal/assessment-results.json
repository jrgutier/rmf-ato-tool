        "observations": [
          {
            "uuid": "75453e66-1a19-5dc2-aaf1-400aecebd8b1",
            "title": "ac-2 determination",
            "description": "Examined the 2026-09-12 quarterly account review and the DT-2 results, and interviewed the ISSO: the 3 administrator and 2 auditor identity-service accounts each match an approved access request, the break-glass account esgadmin is sealed and unused since 2026-06, role mapping and SIEM forwarding of sign-in and account-change events work as the SSP states. However, the shared local account fieldtech is used by 10 field technicians, its password changes every 90 days rather than when a technician leaves the team, and its sign-ins cannot be attributed to a person, so account management does not meet the control's intent for that account.",
            "props": [
              {
                "name": "control-id",
                "ns": "urn:rmf-tool:oscal",
                "value": "ac-2"
