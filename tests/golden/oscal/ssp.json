      "system-name": "Field Data Relay",
      "system-name-short": "FDR",
      "description": "The Field Data Relay collects signed sensor reports from field units and relays them to the analysis enclave .",
      "props": [
        {
          "name": "boundary-id",
          "ns": "urn:rmf-tool:oscal",
          "value": "FDR-BND-1"
        }
      ],
      "security-sensitivity-level": "fips-199-moderate",
