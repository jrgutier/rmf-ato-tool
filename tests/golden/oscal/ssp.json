        "information-types": [
          {
            "uuid": "ac7d7491-4f3b-58fd-86c2-b096176af58e",
            "title": "Sensor reports",
            "description": "Signed reports from field units relayed to the analysis enclave.",
            "categorizations": [
              {
                "system": "https://doi.org/10.6028/NIST.SP.800-60v2r1",
                "information-type-ids": [
                  "D.2.1"
